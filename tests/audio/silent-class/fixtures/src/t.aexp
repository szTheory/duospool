# silent-class: a silent row at S = 16 (R5 $0F, AL $1D, left) under MAN:P8-4: the sum basis is P8-10, so the label does not carry the row (ER-15, D-208).
aexp	sample_mclk=192
scene	t	case=audio_t	role=literal
group	t	period_L	form=ROWS	kind=period	class=MAN:P8-9+H8-23	kills=AF0,AF2,AF4
row	t	period_L	anchor=ev:ch=0;reg=R4;val=$9F;nth=1;from=+50000;to=+300000;side=L	f=256;k=4;d=1024;r1=$FF;al=$1F;r5=$FF
group	t	silent_L	form=ROWS	kind=silent	class=MAN:P8-4	kills=AF0,AF6
row	t	silent_L	from=0;to=ev:ch=0;reg=R4;val=$9F;nth=1;side=L	chon=1;r1=$FF;al=$1D;r5=$0F
