#
# disputed-wrap-zero: a MAN lfo_static row whose unmasked LFO sum f + (w << s) - (16 << s) is 0 (f 16, w $00, shift 0): the sum is read as 4096, a disputed point (ER-15, tests/audio/DISPUTED lfo_wrap). d = k x 4096 holds, so only the wrap rule can report it.
aexp	sample_mclk=192
scene	t	case=audio_t	role=literal
group	t	lfo_w	form=ROWS	kind=lfo_static	class=MAN:P8-6+P8-7+P8-8+P8-9+H8-23	kills=AF0,AF2,AF4
row	t	lfo_w	anchor=ev:ch=G;reg=R9;val=$81;nth=1;from=+100000;to=+500000;side=L	f=16;w=$00;shift=0;k=2;d=8192;r1=$FF;al=$1F;r5=$FF
