# live-class: a MAN period row at S = 1 (AL $1D): audible rows at sums 5 to 14, and any sum but 0 and 4, are ASSUMED (ER-16).
aexp	sample_mclk=192
scene	t	case=audio_t	role=literal
group	t	period_L	form=ROWS	kind=period	class=MAN:P8-9+H8-23	kills=AF0,AF2,AF4
row	t	period_L	anchor=ev:ch=0;reg=R4;val=$9F;nth=1;from=+50000;to=+300000;side=L	f=256;k=4;d=1024;r1=$FF;al=$1D;r5=$FF
group	t	silent_L	form=ROWS	kind=silent	class=MAN:P8-4	kills=AF0,AF6
row	t	silent_L	from=0;to=ev:ch=0;reg=R4;val=$9F;nth=1;side=L	chon=0;r1=$FF;al=$1F;r5=$FF
