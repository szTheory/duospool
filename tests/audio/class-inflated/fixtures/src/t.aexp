# class-inflated: a period group labelled P8-5, which is outside the ceiling MAN:P8-9+P8-10+H8-23 of the kind period (ER-17).
aexp	sample_mclk=192
scene	t	case=audio_t	role=literal
group	t	period_L	form=ROWS	kind=period	class=MAN:P8-5+P8-9+H8-23	kills=AF0,AF2,AF4
row	t	period_L	anchor=ev:ch=0;reg=R4;val=$9F;nth=1;from=+50000;to=+300000;side=L	f=256;k=4;d=1024;r1=$FF;al=$1F;r5=$FF
group	t	silent_L	form=ROWS	kind=silent	class=MAN:P8-4	kills=AF0,AF6
row	t	silent_L	from=0;to=ev:ch=0;reg=R4;val=$9F;nth=1;side=L	chon=0;r1=$FF;al=$1F;r5=$FF
