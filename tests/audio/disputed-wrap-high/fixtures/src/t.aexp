#
# disputed-wrap-high: a MAN lfo_static row whose unmasked LFO sum f + (w << s) - (16 << s) is above 4095 (f 4095, w $1F, shift 0: 4095 + 15 = 4110): the 12-bit mask wraps it to 14, a disputed point (ER-15, tests/audio/DISPUTED lfo_wrap). d = k x 14 holds, so only the wrap rule can report it.
aexp	sample_mclk=192
scene	t	case=audio_t	role=literal
group	t	lfo_w	form=ROWS	kind=lfo_static	class=MAN:P8-6+P8-7+P8-8+P8-9+H8-23	kills=AF0,AF2,AF4
row	t	lfo_w	anchor=ev:ch=G;reg=R9;val=$81;nth=1;from=+100000;to=+500000;side=L	f=4095;w=$1F;shift=0;k=2;d=28;r1=$FF;al=$1F;r5=$FF
