#
# group-vacuous: a ROWS group that kills only the divider (F5) and an origin move (F9): neither can change a pixel row, so no declared fault could flip it.
scene	gv	case=video_gv	role=literal
group	gv	g1	form=ROWS	class=ASSUMED:LED-VID-0010	sym=asym	kills=F5,F9
row	gv	g1	line=active+0;x=0..5	index=2*5,2*300,2*7
