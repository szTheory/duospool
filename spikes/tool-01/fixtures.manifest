#
# TOOL-01 spike manifest (protocol W-08). Shared byte-identically by the C and the Rust option.
#   fixture <name> <size> <sha256>
#   case <id> <kind> <arg> <expect> [control]
# Fixture bytes are generated by gen-fixtures.sh into the gitignored out/ directory; only names, sizes and hashes live here.
# The step-digest expectation is the independent consumer/expect.pl computation, not output of either skeleton.
fixture zero-64k.bin 65536 de2f256064a0af797747c2b97505dc0b9f3df0de4f489eac731c23ae9ca9cc31
fixture lcg-64k.bin 65536 ab0b5936cf56fca6961cd47e3da6f34cc61fa881b25a031d04eb964f21a98bc0
fixture empty.bin 0 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
fixture trunc-65535.bin 65535 b5c65b5710f66938504ef370de02d8d144f45a943a6d332332e25187481fe5b8
fixture hdr-66048.bin 66048 0bfe906f50451c5735bc4461a19160ae50bc6cb6b2c1e73e718b2ba0fd88dcb9
fixture bad-98304.bin 98304 0a96719c78d2a1b0f7eac213f5072b875d6595ba658b08b31645d45a8d6c3f7c
fixture cap-1048576.bin 1048576 30e14955ebf1352266dc2ff8067e68104607e750abb9d3b36582b8af909fcb58
fixture over-1048577.bin 1048577 2cb74edba754a81d121c9db6833704a8e7d417e5b13d1a19f4a52f007d644264
case accept-zero load zero-64k.bin OK
case accept-lcg load lcg-64k.bin OK
case refuse-empty load empty.bin REFUSE_EMPTY
case refuse-trunc load trunc-65535.bin REFUSE_TRUNCATED
case refuse-header load hdr-66048.bin REFUSE_HEADER
case refuse-badsize load bad-98304.bin REFUSE_BAD_SIZE
case refuse-cap load cap-1048576.bin REFUSE_BAD_SIZE
case refuse-over load over-1048577.bin REFUSE_OVERSIZED
case refuse-null api-null - ERR_NULL_ARG
case refuse-short api-short - ERR_SHORT_BUFFER
case refuse-keeps-state refuse-keeps-state - UNCHANGED
case step-digest step-digest lcg-64k.bin digest:c61f7b5e0b76fc29
case interleave interleave - EQUAL
case ctl-wrong-expect load lcg-64k.bin REFUSE_EMPTY control
