/*
 * constants.def - the named modelling constants of the machine, defined once (plan 03-18; D-113, D-134, I6).
 * A constant is a behaviour or a number that no manual page settles (or that the project states as one value) and that is NOT a model parameter: there is one value, no second implementation, no run-request key.
 * One X-macro row per constant: DS_CONST(name, value, ledger)
 *   name    the identifier the core uses, as DS_CONST_name (an enumerator generated from this file in ds_core.h); it is also the key the run record prints in its [constants] table
 *   value   a decimal integer literal without a suffix (the record prints it as text, the conformance case record_constants_shown reads this file as text and compares)
 *   ledger  the ledger id that governs the constant (a single id)
 * The core reads every value from this file: ds_core.h derives DS_MCLK_PER_CYCLE_LOW, DS_MCLK_PER_CYCLE_HIGH, DS_UNMAPPED_READ and DS_ADDER_VDC_ACCESS from the enumerators, boot.c charges the reset cost, cpu.c reads the two TAM and TMA edge constants,
 * and the conformance case record_constants_shown compares the undefined opcode rows of cpu_ops.def with the two undefined opcode constants. So the value the record prints is the value in use and cannot drift from it. Every row is a modelling assumption
 * (the ledger entry is assumed), never a hardware fact; a changed value bumps DS_BEHAVIOUR_EPOCH. The record prints the rows in this order and the ledger ids join its [withheld] table.
 *
 * cycle_mclk_low / cycle_mclk_high    master clocks of one CPU cycle at low and at high speed (D-90); the /3 high-speed figure follows the manual's prescaler, the /12 low-speed figure is a community report
 * reset_cost_mclk                     the machine time a boot charges (D-92): zero
 * undefined_opcode_bytes / _cycles    the 22 undefined opcodes are one byte and two cycles (D-96, D-99)
 * unmapped_read                       the byte an unmapped bank or an absent window reads (D-104)
 * vdc_vce_penalty_cycles              CPU cycles added to every bus access to the VDC and VCE windows (D-107)
 * tam_zero_noop                       1: TAM with the operand $00 changes no MPR and leaves the latch alone; 0: it leaves the MPRs alone and the latch takes A (D-105)
 * tma_multibit_highest                1: TMA with several operand bits returns the highest selected index; 0: the lowest (D-105)
 * block_prologue_cycles                cycles of the block-transfer prologue step (plan 03-25; D-100, LED-CPU-0008): the operand bytes are latched and Y, A and X are pushed in these cycles; the epilogue that pops X, A and Y is the manual's fixed 17 minus this (3) and a byte step is 6
 *                                     (H8-6, S8-88, S8-89; the H8-25 grid misprints 17+16z, errata R-1), with the source read in the fourth cycle of a byte step and the destination written in the sixth, so a transfer of x bytes is 17 + 6x cycles whatever the split (a value from 1 to 16)
 * block_irq_after_epilogue            1: the interrupt inputs are sampled once, at the end of the block epilogue, and never inside a transfer (D-111, LED-IRQ-0007); 0: the epilogue takes no sample and the instruction after the transfer samples first
 * pad_clr_high_nibble                the nibble a read of the $1000 window returns while the latch has CLR set, whatever is held (plan 03-29; D-115, LED-IO-0003): 0
 * io_poweron_latch                    the latch of port O at power-on under every power-on policy (plan 03-29; D-115, R-5, LED-IO-0003): 255 (port O is high after reset, H8-18 and H8-19; which latch bits are SEL and CLR is the project choice of LED-IO-0002)
 * line_mclk                          master clocks of one line of the VCE grid, whatever the dot clock (plan 04-03; D-136, ASSUMED LED-VID-0001): 1365 = 6 x 227.5, a community figure; fclock = 6 fsc is MAN:H6-3, the 227.5 is not from a page held
 * rcr_counter_poweron                 the RCR counter at power-on (plan 04-03; D-142, ASSUMED LED-IRQ-0010): 16384, out of the 10-bit compare range so that nothing matches before the origin line sets it
 * raster_phase_mclk                 the machine time of the first line event of the VCE grid (plan 04-04; D-136, ASSUMED LED-VID-0004): 0, line k starts at raster_phase_mclk + k * line_mclk
 * line_sample_offset_mclk            master clocks from the line origin to its EV_LINE, the instant the line is sampled (plan 04-04; D-136, D-138, ASSUMED LED-VID-0004): 0
 * vce_div_cr0 .. vce_div_cr3         the dot clock divider chosen by the two low bits of the VCE control register (plan 04-04; D-141): 4 and 3 for 00 and 01 are the manual's division ratios (MAN H6-3, LED-VID-0017), 2 and 2 for 10 and 11 are community reports (ASSUMED LED-VID-0002)
 * vce_unused_read                    the byte a read of a VCE register that has no read (CR, CTA, $0401, $0406, $0407) returns (plan 04-04; D-152, ASSUMED LED-VID-0016): 255
 * vce_data_hi_unused_or              the bits OR-ed over bit 0 of a read of the colour table high byte, the seven bits the table does not hold (plan 04-04; D-153, ASSUMED LED-VID-0016): 254
 * vdc_vram_words                    the number of 16-bit words of VRAM the accessor pair holds (plan 04-06; D-147, ASSUMED LED-VID-0007): 32768, a community figure (H7-12 allows a block length of 64K words, no page held states the installed size); a word address at or above it is out of range
 * vdc_oob_read                       the word a VRAM read at an out-of-range word address returns (plan 04-06; D-147, ASSUMED LED-VID-0007): 0; a write there is dropped
 * vdc_bsy_level                      the level of bit 6 (BSY) of the status read (plan 04-06; D-144, D-145, LED-VID-0015 deferred): 0, no bus-arbitration model exists, so the bit never reads busy
 * vdc_dma_dots_per_word              dot-clock periods one word of a VRAM-to-VRAM transfer or of the VRAM-to-SATB copy takes (plan 04-10; D-150, D-151, ASSUMED LED-VID-0014): 4, so a word is 4 * divider master clocks (8, 12 or 16); a modelling choice, the pages state no speed
 * bg_off_index                      the index of every dot with BB = 0 in a frame that is not burst and that no sprite covers (plan 04-11; D-157, LED-VID-0010): 0, the reading of one community source; another reads the blank index 256 (a named disagreement, one value here and no parameter)
 * vid_cgy2_as                      the sprite height class (the CGY value 0 to 3) that a CGY field of 2, which the manual marks "not used", is drawn as (plan 04.1-01; D-159, D-168, ASSUMED LED-VID-0011): 3, so the sprite is 64 lines high and its pattern mask is the one of CGY 3; pcetech and one emulator agree, a named disagreement, no page states it
 * pad_settle_mclk                     master clocks of settling after a write of the latch (plan 03-29; D-115, LED-IO-0004): 0, so a read sees the level of the input schedule at its own access stamp; the read looks up the schedule this many master clocks earlier
 */
DS_CONST(cycle_mclk_low, 12, "LED-CPU-0003")
DS_CONST(cycle_mclk_high, 3, "LED-CPU-0003")
DS_CONST(reset_cost_mclk, 0, "LED-CPU-0004")
DS_CONST(undefined_opcode_bytes, 1, "LED-CPU-0010")
DS_CONST(undefined_opcode_cycles, 2, "LED-CPU-0010")
DS_CONST(unmapped_read, 255, "LED-CPU-0012")
DS_CONST(vdc_vce_penalty_cycles, 1, "LED-CPU-0017")
DS_CONST(tam_zero_noop, 1, "LED-CPU-0015")
DS_CONST(tma_multibit_highest, 1, "LED-CPU-0015")
DS_CONST(timer_hold_on_stop, 1, "LED-IRQ-0003")
DS_CONST(irq_sample_cycles_before_end, 1, "LED-IRQ-0006")
DS_CONST(interrupt_entry_cycles, 8, "LED-CPU-0009")
DS_CONST(speed_switch_extra_cycles, 0, "LED-CPU-0006")
DS_CONST(block_prologue_cycles, 14, "LED-CPU-0008")
DS_CONST(block_irq_after_epilogue, 1, "LED-IRQ-0007")
DS_CONST(pad_clr_high_nibble, 0, "LED-IO-0003")
DS_CONST(io_poweron_latch, 255, "LED-IO-0003")
DS_CONST(pad_settle_mclk, 0, "LED-IO-0004")
DS_CONST(line_mclk, 1365, "LED-VID-0001")
DS_CONST(rcr_counter_poweron, 16384, "LED-IRQ-0010")
DS_CONST(raster_phase_mclk, 0, "LED-VID-0004")
DS_CONST(line_sample_offset_mclk, 0, "LED-VID-0004")
DS_CONST(vce_div_cr0, 4, "LED-VID-0017")
DS_CONST(vce_div_cr1, 3, "LED-VID-0017")
DS_CONST(vce_div_cr2, 2, "LED-VID-0002")
DS_CONST(vce_div_cr3, 2, "LED-VID-0002")
DS_CONST(vce_unused_read, 255, "LED-VID-0016")
DS_CONST(vce_data_hi_unused_or, 254, "LED-VID-0016")
DS_CONST(vdc_vram_words, 32768, "LED-VID-0007")
DS_CONST(vdc_oob_read, 0, "LED-VID-0007")
DS_CONST(vdc_bsy_level, 0, "LED-VID-0015")
DS_CONST(vdc_dma_dots_per_word, 4, "LED-VID-0014")
DS_CONST(bg_off_index, 0, "LED-VID-0010")
DS_CONST(vid_cgy2_as, 3, "LED-VID-0011")
