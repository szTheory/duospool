#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# decision-check - decision-record front-matter checker (D-24, D-25).
# usage: decision-check [--expect CODE[,CODE...]] DIR
#   checks every DIR/*.md, except README.md (the index) and names ending in .protocol.md (D-09: not a record).
#   index rules: INDEX_MISSING, INDEX_DRIFT; name rules: BAD_RECORD_NAME, DUP_RECORD_NUMBER;
#   FIXTURE_RIGHTS_SENTENCE_MISSING (D-04) for 0005-fixture-rights.md.
# stdout: sorted violations  FILE<TAB>CODE<TAB>LINE<TAB>DETAIL , then one line  RECORDS n
# stdout on a met --expect: the single line EXPECT_OK (scripts/check treats a silent exit 0 as a dead checker)
# exit  : 0 pass (or --expect met) | 1 violations (or --expect not met) | 2 usage or harness error
# There is deliberately no git-author check: the agent commits under the owner identity (D-25).
set -eu
LC_ALL=C; export LC_ALL

usage() {
  echo "usage: decision-check [--expect CODE[,CODE...]] DIR" >&2
  exit 2
}

expect=""
have_expect=0
while [ $# -gt 0 ]; do
  case $1 in
    --expect) [ $# -ge 2 ] || usage; expect=$2; have_expect=1; shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
# an --expect that names no code would make a control assert nothing: with no violations got and want are both empty and the
# control would pass vacuously (WR-05). Exit 2, never 0.
if [ "$have_expect" -eq 1 ] && [ -z "$(printf '%s' "$expect" | tr -d ', \t\r\n')" ]; then
  echo "HARNESS_EMPTY_EXPECT --expect names no code" >&2
  exit 2
fi
[ $# -eq 1 ] || usage
dir=$1
if [ ! -d "$dir" ]; then
  echo "HARNESS_NO_FILE $dir" >&2
  exit 2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
viol0="$tmp/viol0"
viol="$tmp/viol"
: > "$viol0"

# per-record rules; output  CODE<TAB>line<TAB>detail
check_record() {
  awk '
    BEGIN {
      FS = "\n"
      split("status blocks default-in-force owner-statement owner-date supersedes superseded-by reopen-if research-ref", ks, " ")
      for (i in ks) known[ks[i]] = 1
      split("## Context and gate|## Options considered|## Decision|## Consequences and what is not decided here", hs, "|")
      infm = 0; closed = 0
    }
    function viol(code, line, detail) { printf "%s\t%s\t%s\n", code, line, detail }
    function present(k) { return (k in val) && val[k] != "" }
    NR == 1 {
      if ($0 != "---") { viol("FM_MISSING", 1, "front matter must start on line 1 with ---"); nofm = 1 }
      else infm = 1
      next
    }
    nofm { next }
    infm {
      if ($0 == "---") { infm = 0; closed = 1; next }
      if ($0 ~ /^[ \t]*$/) next
      if (!match($0, /^[a-z][a-z-]*:/)) { viol("FM_UNKNOWN_KEY", NR, "not key: value"); next }
      k = substr($0, 1, RLENGTH - 1)
      v = substr($0, RLENGTH + 1); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      if (!(k in known)) { viol("FM_UNKNOWN_KEY", NR, k); next }
      if (k in val) { viol("FM_DUP_KEY", NR, k); next }
      val[k] = v; kl[k] = NR
      next
    }
    closed { for (i = 1; i <= 4; i++) if ($0 == hs[i]) hseen[i] = 1 }
    END {
      if (nofm) exit
      if (!closed) { viol("FM_MISSING", NR, "front matter is not closed with ---"); exit }
      st = present("status") ? val["status"] : ""
      if (!("status" in val)) viol("BAD_STATUS", 0, "status missing")
      else if (st !~ /^(open|proposed-default|owner-recorded|superseded|withdrawn)$/) viol("BAD_STATUS", kl["status"], st)
      if (st != "owner-recorded" && !present("blocks")) viol("MISSING_BLOCKS", 0, "")
      if (st == "proposed-default" && !present("default-in-force")) viol("MISSING_DEFAULT_IN_FORCE", 0, "")
      if (st == "owner-recorded") {
        if (!present("owner-statement")) viol("MISSING_OWNER_STATEMENT", 0, "")
        else if (val["owner-statement"] !~ /"/ || (val["owner-statement"] !~ /session/ && val["owner-statement"] !~ /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/))
          viol("STATEMENT_NOT_VERBATIM", kl["owner-statement"], "needs a quoted statement and session or a date")
        if (!present("owner-date")) viol("MISSING_OWNER_DATE", 0, "")
      }
      if (present("owner-date") && val["owner-date"] !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) viol("BAD_OWNER_DATE", kl["owner-date"], val["owner-date"])
      if (!present("research-ref")) viol("MISSING_RESEARCH_REF", 0, "")
      for (i = 1; i <= 4; i++) if (!(i in hseen)) viol("MISSING_SECTION", 0, hs[i])
    }' "$1"
}

addv() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$viol0"; }

# front-matter status of a record: the first status: line between the opening and closing ---; empty if none
fm_status() {
  awk '
    NR == 1 { if ($0 != "---") exit; infm = 1; next }
    infm && $0 == "---" { exit }
    infm && /^status:/ { v = substr($0, 8); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }' "$1"
}

recs="$tmp/recs"
: > "$recs"
n=0
for f in "$dir"/*.md; do
  [ -e "$f" ] || continue
  base=${f##*/}
  case $base in
    README.md) continue ;;
    *.protocol.md) continue ;;
  esac
  n=$((n + 1))
  if printf '%s\n' "$base" | grep -Eq '^[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*\.md$'; then :; else
    addv "$f" BAD_RECORD_NAME 0 "$base"
  fi
  fm_status "$f" > "$tmp/st"
  printf '%s\t%s\n' "$base" "$(cat "$tmp/st")" >> "$recs"
  # a dead awk must not read as "no violations": fail closed with a harness error
  if check_record "$f" > "$tmp/rec"; then :; else
    echo "HARNESS_AWK_FAILED $f" >&2
    exit 2
  fi
  fpath="$f" awk 'BEGIN { FS = OFS = "\t" } { print ENVIRON["fpath"], $1, $2, $3 }' "$tmp/rec" >> "$viol0"
  # D-04: the fixture-rights record states the no-GPL rule as a full line
  if [ "$base" = "0005-fixture-rights.md" ]; then
    if grep -qxF 'No GPL or unclear-licence material is admitted without a further owner decision.' "$f"; then :; else
      addv "$f" FIXTURE_RIGHTS_SENTENCE_MISSING 0 ""
    fi
  fi
done
if [ "$n" -eq 0 ]; then
  printf '%s\tNO_RECORDS\t0\t\n' "$dir" >> "$viol0"
fi

# two records must not share a number
cut -f1 "$recs" | cut -c1-4 | sort | uniq -d > "$tmp/dupnums"
while IFS= read -r num; do
  [ -n "$num" ] || continue
  addv "$dir" DUP_RECORD_NUMBER 0 "$num"
done < "$tmp/dupnums"

# index: README.md has one row per record, with a matching status (D-25)
readme="$dir/README.md"
if [ ! -f "$readme" ]; then
  addv "$readme" INDEX_MISSING 0 ""
else
  # rows are lines starting with "| [": target<TAB>status<TAB>line
  awk '
    /^\| \[/ {
      line = $0
      if (!match(line, /\]\([^)]*\)/)) { printf "%s\t\t%d\n", "?", NR; next }
      tgt = substr(line, RSTART + 2, RLENGTH - 3)
      st = line; sub(/[ \t]*\|[ \t]*$/, "", st); sub(/^.*\|[ \t]*/, "", st)
      printf "%s\t%s\t%d\n", tgt, st, NR
    }' "$readme" > "$tmp/rows"
  # every row names an existing record
  while IFS="$(printf '\t')" read -r tgt st ln; do
    [ -n "$tgt" ] || continue
    if ! awk -F'\t' -v t="$tgt" '$1 == t { found = 1 } END { exit !found }' "$recs"; then
      addv "$readme" INDEX_DRIFT "$ln" "$tgt"
    fi
  done < "$tmp/rows"
  # every record has exactly one row, and the status matches
  while IFS="$(printf '\t')" read -r base rst; do
    [ -n "$base" ] || continue
    cnt=$(awk -F'\t' -v t="$base" '$1 == t { c++ } END { print c + 0 }' "$tmp/rows")
    if [ "$cnt" -ne 1 ]; then
      addv "$dir/$base" INDEX_DRIFT 0 "$base"
    elif [ -n "$rst" ]; then
      ist=$(awk -F'\t' -v t="$base" '$1 == t { print $2 }' "$tmp/rows")
      if [ "$ist" != "$rst" ]; then
        addv "$dir/$base" INDEX_DRIFT 0 "$base"
      fi
    fi
  done < "$recs"
fi
sort "$viol0" > "$viol"

if [ "$have_expect" -eq 1 ]; then
  got=$(awk -F'\t' '{ print $2 }' "$viol" | sort -u | tr '\n' ',' | sed 's/,$//')
  want=$(printf '%s\n' "$expect" | tr ',' '\n' | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ "$got" = "$want" ]; then
    echo "EXPECT_OK"
    exit 0
  fi
  echo "EXPECT_MISMATCH wanted '$want' got '${got:-<none>}'" >&2
  cat "$viol" >&2
  exit 1
fi

cat "$viol"
echo "RECORDS $n"
if [ -s "$viol" ]; then
  exit 1
fi
exit 0
