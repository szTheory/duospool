#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# ledger-check - claim-ledger checker (D-18..D-23). This check enforces structure, not truth.
# usage: ledger-check [--expect CODE[,CODE...]] [--required FILE] [--profiles DIR] PATH...
#   --profiles DIR (default profiles): an entry whose profile has no DIR/<profile>/rN.toml gives PROFILE_UNKNOWN (D-23).
#   PATH is a .toml file or a directory (every *.toml directly inside it is checked).
# stdout: sorted violations  FILE<TAB>CODE<TAB>LINE<TAB>DETAIL , then one line
#         STATUS open=N assumed=N supported=N refuted=N deferred=N withdrawn=N
# stdout on a met --expect: the single line EXPECT_OK (scripts/check treats a silent exit 0 as a dead checker)
# exit  : 0 pass (or --expect met) | 1 violations (or --expect not met) | 2 usage or harness error
set -eu
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd)

usage() {
  echo "usage: ledger-check [--expect CODE[,CODE...]] [--required FILE] [--profiles DIR] PATH..." >&2
  exit 2
}

expect=""
have_expect=0
reqfile=""
profiles_dir="profiles"
while [ $# -gt 0 ]; do
  case $1 in
    --expect) [ $# -ge 2 ] || usage; expect=$2; have_expect=1; shift 2 ;;
    --required) [ $# -ge 2 ] || usage; reqfile=$2; shift 2 ;;
    --profiles) [ $# -ge 2 ] || usage; profiles_dir=$2; shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
# an --expect that names no code would make a control assert nothing: with no violations got and want are both empty and the
# control would pass vacuously (WR-05). Exit 2, never 0.
if [ "$have_expect" -eq 1 ] && [ -z "$(printf '%s' "$expect" | tr -d ', \t\r\n')" ]; then
  echo "HARNESS_EMPTY_EXPECT --expect names no code" >&2
  exit 2
fi
[ $# -ge 1 ] || usage
if [ -n "$reqfile" ] && [ ! -f "$reqfile" ]; then
  echo "HARNESS_NO_FILE $reqfile" >&2
  exit 2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
raw="$tmp/raw"        # FILE<TAB>TAG<TAB>... records from every file
t1="$tmp/stage1"
t2="$tmp/stage2"
viol0="$tmp/viol0"
viol="$tmp/viol"
statusfile="$tmp/status"
: > "$raw"

# bad_name PATH : true when PATH holds a TAB or a newline. Those bytes are the record separators of the stream below,
# so a name carrying one could pick its own record tag and turn garbage into a pass (CR-01). Such a path never reaches
# the stream; it is reported as BAD_FILENAME under a fixed placeholder, and the raw name is not echoed.
tab=$(printf '\t')
nl=$(printf '\n.'); nl=${nl%.}
bad_name() {
  case $1 in
    *"$tab"* | *"$nl"*) return 0 ;;
  esac
  return 1
}
bad_filename() {
  printf '%s\tV\tBAD_FILENAME\t0\tpath contains TAB or newline\n' "<bad-filename>" >> "$raw"
}

# check_file FILE : size gates, stage 1 into a temp file, then stage 2 over that file
check_file() {
  f=$1
  if bad_name "$f"; then
    bad_filename
    return 0
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -eq 0 ]; then
    printf '%s\tV\tEMPTY_FILE\t0\t\n' "$f" >> "$raw"
    return 0
  fi
  if [ "$size" -gt 16384 ]; then
    printf '%s\tV\tFILE_TOO_BIG\t0\t%s bytes\n' "$f" "$size" >> "$raw"
    return 0
  fi
  base=$(basename "$f" .toml)
  # no pipeline: a failing stage 1 must not read as "no violations"
  awk -f "$here/lib/toml-subset.awk" "$f" > "$t1" 2>/dev/null || : > "$t1"
  # stage 2 always prints at least one record; an empty or failed stage 2 is a dead checker, not a pass
  if fname="$base" awk -f "$here/lib/ledger-rules.awk" "$t1" > "$t2" 2>/dev/null && [ -s "$t2" ]; then :; else
    printf '%s\tV\tSTAGE2_DEAD\t0\t\n' "$f" >> "$raw"
    return 0
  fi
  fpath="$f" awk 'BEGIN { FS = OFS = "\t" } { print ENVIRON["fpath"], $0 }' "$t2" >> "$raw"
  return 0
}

for p in "$@"; do
  if bad_name "$p"; then
    bad_filename
    continue
  fi
  if [ -d "$p" ]; then
    n=0
    for f in "$p"/*.toml; do
      [ -e "$f" ] || continue
      n=$((n + 1))
      check_file "$f"
    done
    if [ "$n" -eq 0 ]; then
      printf '%s\tV\tEMPTY_LEDGER\t0\t\n' "$p" >> "$raw"
    fi
  elif [ -f "$p" ]; then
    check_file "$p"
  else
    echo "HARNESS_NO_FILE $p" >&2
    exit 2
  fi
done

# profile cross-check (D-23): each distinct (file, profile) pair must name a profiles/<id>/ holding an rN.toml record.
# The value becomes a path component, so anything outside [a-z0-9-] is unknown without touching the file system.
awk 'BEGIN { FS = "\t" } $2 == "PROFILE" { print $1 "\t" $3 "\t" $4 }' "$raw" | sort -u > "$tmp/profiles"
while IFS="$tab" read -r pf pv pl; do
  [ -n "$pf" ] || continue
  found=0
  case $pv in
    ""|*[!a-z0-9-]*) found=0 ;;
    *)
      for r in "$profiles_dir/$pv"/r[0-9]*.toml; do
        [ -f "$r" ] && found=1
      done
      ;;
  esac
  if [ "$found" -eq 0 ]; then
    printf '%s\tV\tPROFILE_UNKNOWN\t%s\t%s\n' "$pf" "$pl" "$pv" >> "$raw"
  fi
done < "$tmp/profiles"

# REQUIRED file: each non-blank, non-comment line is  LED-ID<space>origin text
# reqgiven=1 once a REQUIRED file is actually read: zero requirement lines then means zero checks, so the cross-file pass
# reports REQUIRED_EMPTY instead of letting an emptied or comment-only file switch the coverage requirement off (WR-06)
reqgiven=0
if [ -n "$reqfile" ] && bad_name "$reqfile"; then
  bad_filename
elif [ -n "$reqfile" ]; then
  reqgiven=1
  reqfile="$reqfile" awk '
    BEGIN { FS = "\n"; rf = ENVIRON["reqfile"] }
    /^[ \t]*(#.*)?$/ { next }
    {
      if ($0 ~ /^LED-(PROF|CPU|VID|AUD|IRQ|LOAD|IO|TOOL)-[0-9][0-9][0-9][0-9] [^ ].*$/) {
        sp = index($0, " "); id = substr($0, 1, sp - 1); org = substr($0, sp + 1)
        printf "%s\tR\t%s\t%s\n", rf, id, org
      } else printf "%s\tB\t%d\t%s\n", rf, NR, $0
    }' "$reqfile" >> "$raw"
fi

# cross-file pass: violations, DUP_ID, REQUIRED checks (REQUIRED_EMPTY included) and the status tally
statusfile="$statusfile" reqgiven="$reqgiven" reqfile="$reqfile" awk '
  BEGIN { FS = "\t"; OFS = "\t" }
  $2 == "V" { print $1, $3, $4, $5; next }
  $2 == "S" { cnt[$3]++; next }
  $2 == "I" { nid[$3]++; idfile[$3, nid[$3]] = $1; next }
  $2 == "F" { have[$3] = 1; org[$3] = $4; next }
  $2 == "R" { nreq++; rid[nreq] = $3; rorg[nreq] = $4; rfile = $1; next }
  $2 == "B" { print $1, "REQUIRED_BAD_LINE", $3, $4; next }
  END {
    for (id in nid) if (nid[id] > 1) for (i = 1; i <= nid[id]; i++) print idfile[id, i], "DUP_ID", 0, id
    if (ENVIRON["reqgiven"] == "1" && nreq == 0) print ENVIRON["reqfile"], "REQUIRED_EMPTY", 0, "no requirement lines"
    for (i = 1; i <= nreq; i++) {
      if (!(rid[i] in have)) print rfile, "REQUIRED_MISSING", 0, rid[i]
      else if (org[rid[i]] != rorg[i]) print rfile, "REQUIRED_ORIGIN_MISMATCH", 0, rid[i] ": wanted " rorg[i] " got " org[rid[i]]
    }
    st = "STATUS"
    n = split("open assumed supported refuted deferred withdrawn", names, " ")
    for (i = 1; i <= n; i++) st = st " " names[i] "=" (cnt[names[i]] + 0)
    print st > ENVIRON["statusfile"]
  }' "$raw" > "$viol0"
sort "$viol0" > "$viol"

if [ "$have_expect" -eq 1 ]; then
  got=$(awk -F'\t' '{ print $2 }' "$viol" | sort -u | tr '\n' ',' | sed 's/,$//')
  want=$(printf '%s\n' "$expect" | tr ',' '\n' | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ "$got" = "$want" ]; then
    echo "EXPECT_OK"
    exit 0
  fi
  echo "EXPECT_MISMATCH wanted '$want' got '${got:-<none>}'" >&2
  cat "$viol" >&2
  exit 1
fi

cat "$viol"
cat "$statusfile"
if [ -s "$viol" ]; then
  exit 1
fi
exit 0
