#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# licence-check - licence-file pin and SPDX-header check (D-01, D-31). This check enforces text identity, not legal advice.
# usage: licence-check [--expect CODE[,CODE...]] [--root DIR]      (--root defaults to the repository root)
#   LICENSE-MIT, LICENSE-APACHE and LICENSE-0BSD must exist (LICENSE_FILE_MISSING).
#   LICENSE-APACHE must match the pinned apache.org sha256 (LICENSE_HASH_MISMATCH).
#   LICENSE-MIT and LICENSE-0BSD must carry the holder line (LICENSE_HOLDER_MISSING) and their permission
#   sentence, matched as a fixed string (LICENSE_TEXT_MISSING).
#   Every regular file under ROOT/scripts/ must carry both SPDX lines in its first five lines (SPDX_HEADER_MISSING). So must every
#   .c, .h and .def file under ROOT/src/ and ROOT/tests/ (D-71), with the same MIT OR Apache-2.0 id; the one exclusion is
#   ROOT/tests/licence/, which holds deliberately headerless controls (a control must be able to lack a header). Every regular
#   file under ROOT/fixtures/ must carry the holder line and the id 0BSD (fixture sources are 0BSD, D-01). So must every regular file under ROOT/tests/oracle/
#   (numeric data transcribed from cited manual pages, 0BSD like the fixtures; plan 03-08, D-131).
# stdout: sorted violations  FILE<TAB>CODE<TAB>LINE<TAB>DETAIL , then one line  RECORDS n
# stdout on a met --expect: the single line EXPECT_OK (scripts/check treats a silent exit 0 as a dead checker)
# exit  : 0 pass (or --expect met) | 1 violations (or --expect not met) | 2 usage or harness error
set -eu
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd)

usage() {
  echo "usage: licence-check [--expect CODE[,CODE...]] [--root DIR]" >&2
  exit 2
}

apache_sha256=cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30
holder='Copyright (c) 2026 The DuoSpool Authors'
mit_sentence='Permission is hereby granted, free of charge, to any person obtaining a copy'
bsd_sentence='Permission to use, copy, modify, and/or distribute this software for any purpose with or without fee is hereby granted.'
spdx_id='SPDX-License-Identifier: MIT OR Apache-2.0'
spdx_fixture_id='SPDX-License-Identifier: 0BSD'
spdx_holder='SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors'

expect=""
have_expect=0
root=$(cd "$here/.." && pwd)
while [ $# -gt 0 ]; do
  case $1 in
    --expect) [ $# -ge 2 ] || usage; expect=$2; have_expect=1; shift 2 ;;
    --root) [ $# -ge 2 ] || usage; root=$2; shift 2 ;;
    *) usage ;;
  esac
done
# an --expect that names no code would make a control assert nothing: with no violations got and want are both empty and the
# control would pass vacuously (WR-05). Exit 2, never 0.
if [ "$have_expect" -eq 1 ] && [ -z "$(printf '%s' "$expect" | tr -d ', \t\r\n')" ]; then
  echo "HARNESS_EMPTY_EXPECT --expect names no code" >&2
  exit 2
fi
if [ ! -d "$root" ]; then
  echo "HARNESS_NO_FILE $root" >&2
  exit 2
fi
root=$(cd "$root" && pwd)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
viol0="$tmp/viol0"
viol="$tmp/viol"
: > "$viol0"
nrec=0

for f in LICENSE-MIT LICENSE-APACHE LICENSE-0BSD; do
  if [ ! -f "$root/$f" ]; then
    printf '%s\tLICENSE_FILE_MISSING\t0\t\n' "$f" >> "$viol0"
  else
    nrec=$((nrec + 1))
  fi
done

if [ -f "$root/LICENSE-APACHE" ]; then
  got=$(shasum -a 256 "$root/LICENSE-APACHE" | awk '{ print $1 }')
  if [ "$got" != "$apache_sha256" ]; then
    printf 'LICENSE-APACHE\tLICENSE_HASH_MISMATCH\t0\t%s\n' "$got" >> "$viol0"
  fi
fi

# check_permissive FILE SENTENCE
check_permissive() {
  [ -f "$root/$1" ] || return 0
  if ! grep -Fq -e "$holder" "$root/$1"; then
    printf '%s\tLICENSE_HOLDER_MISSING\t0\t%s\n' "$1" "$holder" >> "$viol0"
  fi
  if ! grep -Fq -e "$2" "$root/$1"; then
    printf '%s\tLICENSE_TEXT_MISSING\t0\tpermission sentence\n' "$1" >> "$viol0"
  fi
}
check_permissive LICENSE-MIT "$mit_sentence"
check_permissive LICENSE-0BSD "$bsd_sentence"

# spdx_scan LISTFILE ID : every file named in LISTFILE (one path per line) must carry ID and the holder line in its first five lines.
# The expected id is a parameter, so the one rule serves code (MIT OR Apache-2.0) and fixtures (0BSD).
spdx_scan() {
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    nrec=$((nrec + 1))
    rel=${f#"$root"/}
    head -n 5 "$f" > "$tmp/head5"
    if ! grep -Fq -e "$2" "$tmp/head5" || ! grep -Fq -e "$spdx_holder" "$tmp/head5"; then
      printf '%s\tSPDX_HEADER_MISSING\t0\t%s\n' "$rel" "$rel" >> "$viol0"
    fi
  done < "$1"
}

# scripts/: every regular file
if [ -d "$root/scripts" ]; then
  find "$root/scripts" -type f > "$tmp/scripts.list"
  spdx_scan "$tmp/scripts.list" "$spdx_id"
fi

# src/ and tests/: C sources, headers and .def files (tests/licence/ holds the deliberately headerless controls)
: > "$tmp/code.list"
if [ -d "$root/src" ]; then
  find "$root/src" -type f \( -name '*.c' -o -name '*.h' -o -name '*.def' \) >> "$tmp/code.list"
fi
if [ -d "$root/tests" ]; then
  find "$root/tests" -type f \( -name '*.c' -o -name '*.h' -o -name '*.def' \) ! -path "$root/tests/licence/*" >> "$tmp/code.list"
fi
spdx_scan "$tmp/code.list" "$spdx_id"

# fixtures/: every regular file, 0BSD
if [ -d "$root/fixtures" ]; then
  find "$root/fixtures" -type f > "$tmp/fixtures.list"
  spdx_scan "$tmp/fixtures.list" "$spdx_fixture_id"
fi

# tests/oracle/: every regular file, 0BSD (the opcode table transcribed from manual page images is numeric data, plan 03-08)
if [ -d "$root/tests/oracle" ]; then
  find "$root/tests/oracle" -type f > "$tmp/oracle.list"
  spdx_scan "$tmp/oracle.list" "$spdx_fixture_id"
fi

sort -u "$viol0" > "$viol"

if [ "$have_expect" -eq 1 ]; then
  got=$(awk -F'\t' '{ print $2 }' "$viol" | sort -u | tr '\n' ',' | sed 's/,$//')
  want=$(printf '%s\n' "$expect" | tr ',' '\n' | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ "$got" = "$want" ]; then
    echo "EXPECT_OK"
    exit 0
  fi
  echo "EXPECT_MISMATCH wanted '$want' got '${got:-<none>}'" >&2
  cat "$viol" >&2
  exit 1
fi

cat "$viol"
echo "RECORDS $nrec"
if [ -s "$viol" ]; then
  exit 1
fi
exit 0
