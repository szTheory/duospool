#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# check - the Phase 1 gate entry point (D-30). Phase 2 extends this script; it does not add a second one.
# usage: sh scripts/check [--selftest [NAME] | --stage NAME]
#   --selftest mutates a temp copy of scripts/ and proves that a removed rule or a dead stage 1 turns the gate red;
#              with NAME it runs only the mutation printed as SELFTEST NAME (an unknown NAME exits 2)
#   --stage NAME runs only the stage NAME (an unknown NAME exits 2) and exits with that stage's verdict
# stdout: one line per stage  CHECK <stage> PASS|FAIL|ERROR , then  CHECK RESULT PASS|FAIL
# exit  : 0 all stages pass | 1 a stage failed (violation or broken control) | 2 harness error in a stage
set -eu
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
cd "$root"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fails=0
errs=0

# ---- helpers ----

# checker CMD...: run one checker invocation and relay its output and status.
# Every checker prints a marker line on a clean exit (EXPECT_OK, STATUS or RECORDS). A checker that exits 0
# without one is dead (for example a script that /bin/sh stopped parsing at a syntax error): that is a harness
# error (2), never a pass.
checker() {
  if "$@" > "$tmp/chk" 2>&1; then r=0; else r=$?; fi
  cat "$tmp/chk"
  if [ "$r" -eq 0 ] && ! grep -Eq '^(EXPECT_OK$|STATUS |RECORDS )' "$tmp/chk"; then
    echo "CHECKER_DEAD $*"
    return 2
  fi
  return "$r"
}

# read_expect FILE: load a control's EXPECT into $exp. An EXPECT that names no code (empty, blank, or only commas) makes the
# control assert nothing: with no violations, got and want are both empty and the control passes vacuously (WR-05). Returns
# non-zero so the caller can report HARNESS_EMPTY_EXPECT (harness error 2).
read_expect() {
  exp=$(cat "$1")
  [ -n "$(printf '%s' "$exp" | tr -d ', \t\r\n')" ]
}

# rc_expand WORD: set $rc_out to WORD with the first @DIR@ replaced by the current case directory $d (trailing slash kept).
rc_expand() {
  rc_out=$1
  case $rc_out in
    *@DIR@*) rc_out="${rc_out%%@DIR@*}$d${rc_out#*@DIR@}" ;;
  esac
}

# run_controls [OPTIONS] GLOBDIR NOCTRL_LABEL CHECKER_WORD...
# The one control loop (D-58): every GLOBDIR/<case>/ is a control run through the checker command. Options, before GLOBDIR:
#   --ok-prefix         cases named ok-* must pass and run without --expect; every other case needs an EXPECT file
#   --expect-selects    a case with an EXPECT file must fail on it; one without runs as a must-pass sample when named ok-*,
#                       and is HARNESS_NO_EXPECT otherwise (the profile stage)
#   --need LABEL PATH   PATH (may hold @DIR@) must be a file, else LABEL is reported and the case skipped (harness error 2)
#   --opt-file PATH FLAG  when PATH exists, @OPT@ expands to FLAG PATH, else to nothing
#   --require-negative  NO_CONTROLS also when no case is a must-fail control
# CHECKER_WORD words (one per argument, no newline inside): @DIR@ is the case directory, @EXPECT@ expands to the two words
# --expect TEXT for a must-fail case and to nothing for a must-pass one, @OPT@ is described above. Exit 1 from the checker
# on a must-fail case means the control is broken; on a must-pass case, the sample was rejected. rc stays a global, exactly
# as in the loops this replaced.
run_controls() {
  rc_okpfx=0
  rc_exsel=0
  rc_negreq=0
  rc_optpath=
  rc_optflag=
  : > "$tmp/rc.need"
  while [ $# -gt 0 ]; do
    case $1 in
      --ok-prefix) rc_okpfx=1; shift ;;
      --expect-selects) rc_exsel=1; shift ;;
      --require-negative) rc_negreq=1; shift ;;
      --need) printf '%s\n%s\n' "$2" "$3" >> "$tmp/rc.need"; shift 3 ;;
      --opt-file) rc_optpath=$2; rc_optflag=$3; shift 3 ;;
      *) break ;;
    esac
  done
  rc_glob=$1
  rc_noctl=$2
  shift 2
  : > "$tmp/rc.tpl"
  for rc_w in "$@"; do
    printf '%s\n' "$rc_w" >> "$tmp/rc.tpl"
  done
  rc=0
  n=0
  neg=0
  for d in "$rc_glob"/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    case_name=$(basename "$d")
    case $case_name in
      ok-*) rc_isok=1 ;;
      *) rc_isok=0; neg=$((neg + 1)) ;;
    esac
    rc_miss=
    while IFS= read -r rc_lab && IFS= read -r rc_np; do
      rc_expand "$rc_np"
      if [ ! -f "$rc_out" ]; then rc_miss=$rc_lab; break; fi
    done < "$tmp/rc.need"
    if [ -n "$rc_miss" ]; then
      echo "$rc_miss $case_name"
      rc=2
      continue
    fi
    rc_mustfail=1
    if [ "$rc_exsel" -eq 1 ]; then
      if [ ! -f "${d}EXPECT" ]; then
        if [ "$rc_isok" -eq 1 ]; then
          rc_mustfail=0
        else
          echo "HARNESS_NO_EXPECT $case_name"
          rc=2
          continue
        fi
      fi
    elif [ "$rc_okpfx" -eq 1 ] && [ "$rc_isok" -eq 1 ]; then
      rc_mustfail=0
    fi
    if [ "$rc_mustfail" -eq 1 ]; then
      if [ ! -f "${d}EXPECT" ]; then
        echo "HARNESS_NO_EXPECT $case_name"
        rc=2
        continue
      fi
      if ! read_expect "${d}EXPECT"; then
        echo "HARNESS_EMPTY_EXPECT $case_name"
        rc=2
        continue
      fi
    fi
    set --
    while IFS= read -r rc_w; do
      case $rc_w in
        @EXPECT@)
          if [ "$rc_mustfail" -eq 1 ]; then set -- "$@" --expect "$exp"; fi
          ;;
        @OPT@)
          if [ -n "$rc_optpath" ]; then
            rc_expand "$rc_optpath"
            if [ -f "$rc_out" ]; then set -- "$@" "$rc_optflag" "$rc_out"; fi
          fi
          ;;
        *)
          rc_expand "$rc_w"
          set -- "$@" "$rc_out"
          ;;
      esac
    done < "$tmp/rc.tpl"
    if checker "$@" > "$tmp/case.out"; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ]; then
      if [ "$rc_mustfail" -eq 1 ]; then echo "CONTROL BROKEN $case_name"; else echo "SAMPLE REJECTED $case_name"; fi
      sed 's/^/  /' "$tmp/case.out"
      [ "$rc" -eq 2 ] || rc=1 # rc-broken-status
    elif [ "$r" -ne 0 ]; then
      echo "HARNESS_ERROR $case_name"
      sed 's/^/  /' "$tmp/case.out"
      rc=2
    fi
  done
  if [ "$n" -eq 0 ] || { [ "$rc_negreq" -eq 1 ] && [ "$neg" -eq 0 ]; }; then
    echo "NO_CONTROLS $rc_noctl"
    [ "$rc" -eq 2 ] || rc=1
  fi
  return "$rc"
}

# ---- stages: each is a function that prints details and returns 0 pass, 1 fail, 2 harness error ----

stage_ledger_entries() {
  checker sh "$here/ledger-check" --required ledger/REQUIRED ledger/entries/
}

# every ledger/negative/<case>/ is a control; its EXPECT file holds the exact code set, an optional
# REQUIRED file is passed through. Exit 1 from the checker means the control is broken.
stage_ledger_negatives() {
  run_controls --opt-file @DIR@/REQUIRED --required ledger/negative ledger/negative sh "$here/ledger-check" @EXPECT@ @OPT@ @DIR@
}

# every ledger/samples/ok-<case>/ is a must-pass control
stage_ledger_samples() {
  rc=0
  n=0
  for d in ledger/samples/ok-*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    case_name=$(basename "$d")
    if checker sh "$here/ledger-check" "$d" > "$tmp/case.out"; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ]; then
      echo "SAMPLE REJECTED $case_name"
      sed 's/^/  /' "$tmp/case.out"
      [ "$rc" -eq 2 ] || rc=1
    elif [ "$r" -ne 0 ]; then
      echo "HARNESS_ERROR $case_name"
      sed 's/^/  /' "$tmp/case.out"
      rc=2
    fi
  done
  if [ "$n" -eq 0 ]; then
    echo "NO_CONTROLS ledger/samples"
    [ "$rc" -eq 2 ] || rc=1
  fi
  return "$rc"
}

stage_decision_records() {
  checker sh "$here/decision-check" docs/decisions
}

# every tests/decision/<case>/ is a control with an EXPECT file; every tests/decision/ok-<case>/ must pass
stage_decision_negatives() {
  run_controls --ok-prefix tests/decision tests/decision sh "$here/decision-check" @EXPECT@ @DIR@
}

# every profiles/<id>/rN.toml must pass; no record at all is a dead gate, not a pass
stage_profile_records() {
  n=0
  for f in profiles/*/r*.toml; do
    [ -e "$f" ] || continue
    n=$((n + 1))
  done
  if [ "$n" -eq 0 ]; then
    echo "NO_RECORDS profiles"
    return 1
  fi
  checker sh "$here/profile-check" profiles/*/r*.toml
}

# every tests/profile/<case>/ with an EXPECT is a must-fail control on <case>/pce-hucard-2btn/r1.toml; every
# tests/profile/ok-<case>/ without one must pass. Exit 1 from the checker means the control is broken.
stage_profile_negatives() {
  run_controls --expect-selects --need HARNESS_NO_RECORD @DIR@pce-hucard-2btn/r1.toml tests/profile tests/profile sh "$here/profile-check" @EXPECT@ @DIR@pce-hucard-2btn/r1.toml
}

# a TAB or a newline in an input path must be refused as BAD_FILENAME (CR-01): those bytes are the record separators of
# the ledger and profile checkers' internal stream, so a name carrying one could pick its own record tag and turn garbage
# into a pass. The names are created at run time under $tmp because git cannot be relied on to carry such a name on every
# host. The expected code is fixed here: BAD_FILENAME, and without --expect the checker must exit 1.
# name_control CASE CHECKER PATH
name_control() {
  nc_case=$1
  nc_ck=$2
  nc_path=$3
  if checker sh "$here/$nc_ck" --expect BAD_FILENAME "$nc_path" > "$tmp/case.out"; then r=0; else r=$?; fi
  if [ "$r" -eq 1 ]; then
    echo "CONTROL BROKEN $nc_case"
    sed 's/^/  /' "$tmp/case.out"
    [ "$rc" -eq 2 ] || rc=1
    return 0
  elif [ "$r" -ne 0 ]; then
    echo "HARNESS_ERROR $nc_case"
    sed 's/^/  /' "$tmp/case.out"
    rc=2
    return 0
  fi
  if checker sh "$here/$nc_ck" "$nc_path" > "$tmp/case.out"; then r=0; else r=$?; fi
  if [ "$r" -ne 1 ]; then
    echo "CONTROL BROKEN $nc_case (exit $r without --expect, wanted 1)"
    sed 's/^/  /' "$tmp/case.out"
    [ "$rc" -eq 2 ] || rc=1
  fi
  return 0
}

stage_filename_controls() {
  rc=0
  tab=$(printf '\t')
  nl=$(printf '\n.'); nl=${nl%.}
  w="$tmp/names"
  rm -rf "$w"
  # the contents are garbage on purpose: under a plain name every one of these files is rejected for other reasons, so
  # only the name decides whether the checker reports BAD_FILENAME
  if mkdir -p "$w/led-tab" "$w/led-nl" "$w/led-dir${tab}x" "$w/prof-tab" "$w/prof-nl" "$w/prof-dir${tab}d" \
    && printf 'garbage line\n' > "$w/led-tab/x${tab}F${tab}y${tab}z.toml" \
    && printf 'garbage line\n' > "$w/led-nl/a${nl}b.toml" \
    && printf 'garbage line\n' > "$w/led-dir${tab}x/ok.toml" \
    && printf 'garbage\n' > "$w/prof-tab/r1${tab}P${tab}x.toml" \
    && printf 'garbage\n' > "$w/prof-nl/r1${nl}x.toml" \
    && printf 'garbage\n' > "$w/prof-dir${tab}d/r1.toml"; then :; else
    echo "HARNESS_ERROR cannot create the tab and newline named files"
    return 2
  fi
  name_control ledger-tab-in-name ledger-check "$w/led-tab"
  name_control ledger-newline-in-name ledger-check "$w/led-nl"
  name_control ledger-tab-in-dir ledger-check "$w/led-dir${tab}x"
  name_control ledger-tab-in-file-argument ledger-check "$w/led-tab/x${tab}F${tab}y${tab}z.toml"
  name_control profile-tab-in-name profile-check "$w/prof-tab/r1${tab}P${tab}x.toml"
  name_control profile-newline-in-name profile-check "$w/prof-nl/r1${nl}x.toml"
  name_control profile-tab-in-dir profile-check "$w/prof-dir${tab}d/r1.toml"
  return "$rc"
}

# an empty --expect, or an EXPECT file that names no code, must be a harness error and never a vacuous pass (WR-05). Fixed
# expectations: every checker exits 2 on --expect "" (and on a blank or comma-only value), and read_expect refuses an empty,
# blank or comma-only EXPECT file while accepting a real one.
# empty_expect_control CASE CHECKER ARGS... : the checker must exit 2 for each degenerate --expect value
empty_expect_control() {
  ec_case=$1
  ec_ck=$2
  shift 2
  for ec_val in "" " " "," ", ,"; do
    if sh "$here/$ec_ck" --expect "$ec_val" "$@" > "$tmp/case.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -ne 2 ] || grep -q '^EXPECT_OK$' "$tmp/case.out"; then
      echo "CONTROL BROKEN $ec_case (--expect '$ec_val' exited $r, wanted 2)"
      sed 's/^/  /' "$tmp/case.out"
      [ "$rc" -eq 2 ] || rc=1
    fi
  done
}

stage_empty_expect_controls() {
  rc=0
  empty_expect_control ledger-check ledger-check ledger/entries/
  empty_expect_control profile-check profile-check profiles/pce-hucard-2btn/r1.toml
  empty_expect_control decision-check decision-check docs/decisions
  empty_expect_control provenance-check provenance-check
  empty_expect_control licence-check licence-check
  empty_expect_control check-results check-results docs/decisions/0001-language-build.protocol.md --record docs/decisions/0001-language-build.md
  empty_expect_control protocol-order-check protocol-order-check
  w="$tmp/expects"
  rm -rf "$w"
  mkdir -p "$w" || { echo "HARNESS_ERROR cannot create $w"; return 2; }
  : > "$w/empty"
  printf '\n' > "$w/newline"
  printf '  \n' > "$w/blank"
  printf ',\n' > "$w/comma"
  printf 'SOME_CODE\n' > "$w/real"
  for ec_f in empty newline blank comma; do
    if read_expect "$w/$ec_f"; then
      echo "CONTROL BROKEN read_expect accepted the $ec_f EXPECT file"
      [ "$rc" -eq 2 ] || rc=1
    fi
  done
  if ! read_expect "$w/real"; then
    echo "CONTROL BROKEN read_expect refused a real EXPECT file"
    [ "$rc" -eq 2 ] || rc=1
  fi
  return "$rc"
}

stage_provenance_register() {
  checker sh "$here/provenance-check"
}

# every tests/provenance/<case>/ with an EXPECT is a must-fail control run under its own --root; every
# tests/provenance/ok-<case>/ must pass. Exit 1 from the checker means the control is broken.
stage_provenance_negatives() {
  run_controls --ok-prefix tests/provenance tests/provenance sh "$here/provenance-check" --root @DIR@ @EXPECT@
}

stage_licence_files() {
  checker sh "$here/licence-check"
}

# every tests/licence/<case>/ with an EXPECT is a must-fail control run under its own --root; every
# tests/licence/ok-<case>/ must pass. Exit 1 from the checker means the control is broken.
stage_licence_negatives() {
  run_controls --ok-prefix tests/licence tests/licence sh "$here/licence-check" --root @DIR@ @EXPECT@
}

stage_protocol_order() {
  checker sh "$here/protocol-order-check"
}

# synthetic.sh prints one SYNTH line per case; its exit status is the verdict. The marker line keeps a dead script
# (for example one /bin/sh stopped parsing) from passing as an empty success.
stage_protocol_negatives() {
  if sh tests/protocol/synthetic.sh > "$tmp/case.out" 2>&1; then r=0; else r=$?; fi
  cat "$tmp/case.out"
  if [ "$r" -eq 0 ] && ! grep -q '^SYNTH .* PASS$' "$tmp/case.out"; then
    echo "NO_CONTROLS tests/protocol"
    return 1
  fi
  return "$r"
}

# every tests/score/<case>/ is a control: scores.txt is the scorer input and EXPECT lists lines that the scorer's output
# must contain verbatim. `EXIT=n` expects that exit status instead of 0, and `CODE=X` expects an output line whose first
# word is X. A case that disagrees is a broken control (the decision rule moved, or the control is wrong).
stage_score_controls() {
  rc=0
  n=0
  for d in tests/score/*/; do
    [ -d "$d" ] || continue
    n=$((n + 1))
    case_name=$(basename "$d")
    if [ ! -f "${d}scores.txt" ] || [ ! -f "${d}EXPECT" ]; then
      echo "HARNESS_NO_EXPECT $case_name"
      rc=2
      continue
    fi
    if ! read_expect "${d}EXPECT"; then
      echo "HARNESS_EMPTY_EXPECT $case_name"
      rc=2
      continue
    fi
    if awk -f "$here/lib/score.awk" "${d}scores.txt" > "$tmp/case.out" 2>&1; then r=0; else r=$?; fi
    want=0
    if grep -q '^EXIT=' "${d}EXPECT"; then
      want=$(sed -n 's/^EXIT=//p' "${d}EXPECT" | sed -n 1p)
    fi
    ok=1
    [ "$r" -eq "$want" ] || ok=0
    while IFS= read -r line; do
      case $line in
        '' | EXIT=*) ;;
        CODE=*)
          code=${line#CODE=}
          awk -v c="$code" '$1 == c { f = 1 } END { exit !f }' "$tmp/case.out" || ok=0
          ;;
        *) grep -Fxq -e "$line" "$tmp/case.out" || ok=0 ;;
      esac
    done < "${d}EXPECT"
    if [ "$ok" -eq 0 ]; then
      echo "CONTROL BROKEN $case_name (exit $r, wanted $want)"
      sed 's/^/  /' "$tmp/case.out"
      [ "$rc" -eq 2 ] || rc=1
    fi
  done
  if [ "$n" -eq 0 ]; then
    echo "NO_CONTROLS tests/score"
    [ "$rc" -eq 2 ] || rc=1
  fi
  return "$rc"
}

# the real record 0001: every pre-registered (metric, variant) row has a value for both options (D-12, D-15), and the record
# carries the scorer's RESULT= line. Structure only: the check does not judge whether a value is good.
stage_results() {
  checker sh "$here/check-results" docs/decisions/0001-language-build.protocol.md --record docs/decisions/0001-language-build.md
}

# every tests/results/<case>/ is a control on its own protocol.md and record.md: a case with an EXPECT file is a must-fail
# control run in --record mode, and every tests/results/ok-<case>/ must pass. Exit 1 from the checker means the control is broken.
stage_results_negatives() {
  run_controls --ok-prefix --require-negative --need HARNESS_NO_FILE @DIR@protocol.md --need HARNESS_NO_FILE @DIR@record.md tests/results tests/results sh "$here/check-results" @EXPECT@ @DIR@protocol.md --record @DIR@record.md
}

# every tests/gate/ingest/<case>/ is a mini-root: results.txt is a fabricated runner output, tests/conformance/ holds its
# REQUIRED and cases/, and a case with an EXPECT file must fail on exactly that code set. Every ok-<case> must pass. A control
# that passes without its EXPECT met means the judge is broken (D-57, D-58, D-79(c)).
stage_ingest_controls() {
  run_controls --ok-prefix --require-negative --need HARNESS_NO_FILE @DIR@results.txt tests/gate/ingest tests/gate/ingest sh "$here/conformance-ingest" --root @DIR@ --results @DIR@results.txt @EXPECT@
}

# every tests/gate/flatten/<case>/ is a directory of input TOML: a case with an EXPECT file must fail on exactly that code set
# and every ok-<case> must pass. Then three probes that run_controls cannot express, built at run time under $tmp: a directory
# holding one good and one bad file must print not one byte on stdout (no partial TSV, D-51), the ok case must print its key
# rows and end with an END row that counts both files, and a TAB in a file name must be refused as BAD_FILENAME.
stage_flatten_controls() {
  run_controls --ok-prefix --require-negative tests/gate/flatten tests/gate/flatten sh "$here/conformance-flatten" @EXPECT@ @DIR@
  fc_rc=$rc
  tab=$(printf '\t')
  w="$tmp/flatten"
  rm -rf "$w"
  if mkdir -p "$w/mixed" "$w/tabname" \
    && cp tests/gate/flatten/ok-two-files/a.toml "$w/mixed/a-good.toml" \
    && cp tests/gate/flatten/bad-syntax/a.toml "$w/mixed/z-bad.toml" \
    && cp tests/gate/flatten/ok-two-files/a.toml "$w/tabname/a${tab}b.toml"; then :; else
    echo "HARNESS_ERROR cannot create the flatten probe files"
    return 2
  fi
  if sh "$here/conformance-flatten" "$w/mixed" > "$w/mixed.out" 2> "$w/mixed.err"; then r=0; else r=$?; fi
  bytes=$(wc -c < "$w/mixed.out" | tr -d ' ')
  if [ "$r" -ne 1 ] || [ "$bytes" -ne 0 ]; then
    echo "CONTROL BROKEN mixed-good-and-bad (exit $r, $bytes stdout bytes, wanted exit 1 and 0 bytes)"
    sed 's/^/  /' "$w/mixed.err"
    [ "$fc_rc" -eq 2 ] || fc_rc=1
  fi
  if sh "$here/conformance-flatten" tests/gate/flatten/ok-two-files > "$w/ok.out" 2> "$w/ok.err"; then r=0; else r=$?; fi
  last=$(tail -n 1 "$w/ok.out")
  if [ "$r" -ne 0 ] || [ "$last" != "END${tab}2" ] || ! grep -q "^K${tab}" "$w/ok.out"; then
    echo "CONTROL BROKEN ok-two-files-rows (exit $r, last row '$last')"
    sed 's/^/  /' "$w/ok.err"
    [ "$fc_rc" -eq 2 ] || fc_rc=1
  fi
  if sh "$here/conformance-flatten" --expect BAD_FILENAME "$w/tabname" > "$w/tab.out" 2>&1; then r=0; else r=$?; fi
  if [ "$r" -ne 0 ]; then
    echo "CONTROL BROKEN tab-in-file-name (exit $r, wanted BAD_FILENAME)"
    sed 's/^/  /' "$w/tab.out"
    [ "$fc_rc" -eq 2 ] || fc_rc=1
  fi
  return "$fc_rc"
}

# cancel_reap PIDFILE: the stub records its pid; kill it when it is still the sleeping stub (the process the supervisor was
# meant to kill), so that no run of the controls, mutated or not, leaves a spinning process behind. The command line is
# checked first so that a recycled pid is never signalled.
cancel_reap() {
  [ -f "$1" ] || return 0
  cr_pid=$(cat "$1")
  case $cr_pid in '' | *[!0-9]*) return 0 ;; esac
  if ps -o command= -p "$cr_pid" 2> /dev/null | grep -q 'sleep 600'; then
    kill "$cr_pid" 2> /dev/null || true
  fi
  return 0
}

# cancel_sequence RUN WORKDIR: the D-77 controls against the conformance-run script RUN, files under WORKDIR. First a SIGTERM
# to a supervisor whose stub has finished case a and then spins: the file must end up with the a line unchanged, a cancelled
# line for b and for c naming the signal, and RUNNER_DONE 3, the supervisor must exit 1 and say CANCELLED, and the judge must
# call the result non-green with exactly the cancelled class. Then a wall expiry (no signal): exit 2, HARNESS_WALL, and no
# cancelled line, because the watchdog is a different outcome. Returns 0 pass, 1 broken control, 2 harness error.
cancel_sequence() {
  cs_run=$1
  cs_w=$2
  cs_c=tests/gate/cancel
  cs_rc=0
  rm -rf "$cs_w"
  mkdir -p "$cs_w" || { echo "HARNESS_ERROR cannot create $cs_w"; return 2; }
  sh "$cs_run" supervise --ids "$cs_c/ids.txt" --out "$cs_w/out.txt" -- sh "$cs_c/spin.sh" "$cs_w/pid" > "$cs_w/sup.out" 2> "$cs_w/sup.err" &
  cs_sup=$!
  cs_i=0
  while [ "$cs_i" -lt 50 ] && ! grep -q '^RESULT a pass ' "$cs_w/out.txt" 2> /dev/null; do
    sleep 0.1
    cs_i=$((cs_i + 1))
  done
  if [ "$cs_i" -ge 50 ]; then
    echo "HARNESS_ERROR the stub never produced its a line within 5 s"
    kill "$cs_sup" 2> /dev/null || true
    wait "$cs_sup" 2> /dev/null || true
    cancel_reap "$cs_w/pid"
    return 2
  fi
  kill -TERM "$cs_sup"
  if wait "$cs_sup"; then cs_r=0; else cs_r=$?; fi
  cancel_reap "$cs_w/pid"
  if [ "$cs_r" -ne 1 ]; then
    echo "CONTROL BROKEN cancel-exit (supervisor exit $cs_r after SIGTERM, wanted 1)"
    cs_rc=1
  fi
  if ! grep -qx 'CANCELLED signal:TERM n=3' "$cs_w/sup.out"; then
    echo "CONTROL BROKEN cancel-message (no 'CANCELLED signal:TERM n=3' on stdout)"
    cs_rc=1
  fi
  cs_n=$(wc -l < "$cs_w/out.txt" | tr -d ' ')
  if [ "$cs_n" -ne 4 ] \
    || ! sed -n 1p "$cs_w/out.txt" | awk '$1 == "RESULT" && $2 == "a" && $3 == "pass" { f = 1 } END { exit !f }' \
    || [ "$(sed -n 2p "$cs_w/out.txt")" != 'RESULT b cancelled assertions=0 evidence=signal:TERM' ] \
    || [ "$(sed -n 3p "$cs_w/out.txt")" != 'RESULT c cancelled assertions=0 evidence=signal:TERM' ] \
    || [ "$(sed -n 4p "$cs_w/out.txt")" != 'RUNNER_DONE 3' ]; then
    echo "CONTROL BROKEN cancel-lines (the results file after SIGTERM is not a, b cancelled, c cancelled, RUNNER_DONE 3)"
    sed 's/^/  /' "$cs_w/out.txt"
    cs_rc=1
  fi
  if sh "$here/conformance-ingest" --root "$cs_c" --results "$cs_w/out.txt" --expect OUTCOME_CANCELLED > "$cs_w/ing.out" 2>&1 && grep -qx 'EXPECT_OK' "$cs_w/ing.out"; then :; else
    echo "CONTROL BROKEN cancel-judged (the judge did not report exactly OUTCOME_CANCELLED)"
    sed 's/^/  /' "$cs_w/ing.out"
    cs_rc=1
  fi
  if sh "$here/conformance-ingest" --root "$cs_c" --results "$cs_w/out.txt" > "$cs_w/ing2.out" 2>&1; then cs_r=0; else cs_r=$?; fi
  if [ "$cs_r" -ne 1 ]; then
    echo "CONTROL BROKEN cancel-not-green (the judge exited $cs_r on a cancelled result, wanted 1)"
    cs_rc=1
  fi
  if sh "$cs_run" supervise --wall 1 --ids "$cs_c/ids.txt" --out "$cs_w/wall.txt" -- sh "$cs_c/spin.sh" "$cs_w/wpid" > "$cs_w/wall.out" 2> "$cs_w/wall.err"; then cs_r=0; else cs_r=$?; fi
  cancel_reap "$cs_w/wpid"
  if [ "$cs_r" -ne 2 ] || ! grep -q '^HARNESS_WALL seconds=1$' "$cs_w/wall.err" || grep -q 'cancelled' "$cs_w/wall.txt" "$cs_w/wall.out"; then
    echo "CONTROL BROKEN wall-not-cancelled (exit $cs_r, wanted 2 with HARNESS_WALL and no cancelled line)"
    sed 's/^/  /' "$cs_w/wall.err"
    cs_rc=1
  fi
  return "$cs_rc"
}

stage_cancel_controls() {
  cancel_sequence "$here/conformance-run" "$tmp/cancel"
}

# ---- self-test: prove the gate is alive (not vacuous). Mutates a COPY of scripts/ only ----

# st_want NAME: true when no mutation was selected (run them all) or NAME is the selected one
st_want() {
  [ -z "$st_sel" ] || [ "$st_sel" = "$1" ]
}

selftest() {
  cp_dir="$tmp/selftest/scripts"
  mkdir -p "$tmp/selftest"
  failed=0
  st_ran=0

  # (a) delete the rule that emits SUPPORTED_NO_QUALIFYING_EVIDENCE: the e0-e4 control must now be broken (exit 1)
  if st_want mutation-supported-rule; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    grep -v 'SUPPORTED_NO_QUALIFYING_EVIDENCE' "$cp_dir/lib/ledger-rules.awk" > "$cp_dir/lib/ledger-rules.mutated"
    mv "$cp_dir/lib/ledger-rules.mutated" "$cp_dir/lib/ledger-rules.awk"
    if sh "$cp_dir/ledger-check" --expect SUPPORTED_NO_QUALIFYING_EVIDENCE ledger/negative/e0-e4/ > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ]; then echo "SELFTEST mutation-supported-rule PASS"; else echo "SELFTEST mutation-supported-rule FAIL"; failed=1; fi
  fi

  # (b) a stage 1 that prints nothing must give NO_SENTINEL and exit 1, never a pass
  if st_want missing-sentinel; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    echo 'BEGIN { exit 0 }' > "$cp_dir/lib/toml-subset.awk"
    if sh "$cp_dir/ledger-check" ledger/entries/ > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ] && grep -q 'NO_SENTINEL' "$tmp/st.out"; then echo "SELFTEST missing-sentinel PASS"; else echo "SELFTEST missing-sentinel FAIL"; failed=1; fi
  fi

  # (c) delete the rule that emits OPEN_HAS_VALUE from profile-rules.awk: the open-with-value control must now be broken (exit 1)
  if st_want mutation-profile-rule; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    grep -v 'OPEN_HAS_VALUE' "$cp_dir/lib/profile-rules.awk" > "$cp_dir/lib/profile-rules.mutated"
    mv "$cp_dir/lib/profile-rules.mutated" "$cp_dir/lib/profile-rules.awk"
    if sh "$cp_dir/profile-check" --expect OPEN_HAS_VALUE tests/profile/open-with-value/pce-hucard-2btn/r1.toml > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ]; then echo "SELFTEST mutation-profile-rule PASS"; else echo "SELFTEST mutation-profile-rule FAIL"; failed=1; fi
  fi

  # (d) delete the rule that emits PROV_BAD_SPDX: the gpl-spdx control must now be broken (exit 1)
  if st_want mutation-provenance-rule; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    grep -v 'PROV_BAD_SPDX' "$cp_dir/lib/provenance-register.awk" > "$cp_dir/lib/provenance-register.mutated"
    mv "$cp_dir/lib/provenance-register.mutated" "$cp_dir/lib/provenance-register.awk"
    if sh "$cp_dir/provenance-check" --root tests/provenance/gpl-spdx --expect PROV_BAD_SPDX > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ]; then echo "SELFTEST mutation-provenance-rule PASS"; else echo "SELFTEST mutation-provenance-rule FAIL"; failed=1; fi
  fi

  # (e) delete the rule that emits margin-below-10 from score.awk: the 9.90-point control must now be broken, because
  # the scorer would pre-authorize or blame the ND rule instead of rejecting a lead under 10.00
  if st_want mutation-margin-rule; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    grep -v 'margin-below-10' "$cp_dir/lib/score.awk" > "$cp_dir/lib/score.mutated"
    mv "$cp_dir/lib/score.mutated" "$cp_dir/lib/score.awk"
    if awk -f "$cp_dir/lib/score.awk" tests/score/margin-9.90/scores.txt > "$tmp/st.out" 2>&1 && ! grep -qx 'REASON=margin-below-10' "$tmp/st.out"; then
      echo "SELFTEST mutation-margin-rule PASS"
    else
      echo "SELFTEST mutation-margin-rule FAIL"; failed=1
    fi
  fi

  # (f) run_controls must turn the gate red on a broken control, and only because of the one line that sets the failing
  # status. A scratch mini-repo holds a copy of scripts/ and one licence control whose EXPECT names a code the checker never
  # emits, so the control is broken by construction. Unmutated, --stage licence-negatives must exit 1 and name the case;
  # with the single line carrying the status marker deleted, the same run must exit 0, so the mutation silenced exactly the
  # rule under test. The marker is assembled here so that this script carries it only once, on the line being removed.
  if st_want mutation-run-controls; then
    st_ran=1
    mini="$tmp/selftest/mini"
    rm -rf "$mini"
    mkdir -p "$mini/tests/licence/broken"
    cp -R "$here" "$mini/scripts"
    printf 'SELFTEST_CODE_NEVER_EMITTED\n' > "$mini/tests/licence/broken/EXPECT"
    tok=rc-broken-
    tok="${tok}status"
    st_alive=0
    if sh "$mini/scripts/check" --stage licence-negatives > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r" -eq 1 ] && grep -qx 'CHECK licence-negatives FAIL' "$tmp/st.out" && grep -q 'CONTROL BROKEN broken' "$tmp/st.out"; then st_alive=1; fi
    before=$(grep -c "$tok" "$mini/scripts/check" || true)
    grep -v "$tok" "$mini/scripts/check" > "$mini/scripts/check.mutated" || true
    mv "$mini/scripts/check.mutated" "$mini/scripts/check"
    after=$(grep -c "$tok" "$mini/scripts/check" || true)
    if sh "$mini/scripts/check" --stage licence-negatives > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$st_alive" -eq 1 ] && [ "$before" -eq 1 ] && [ "$after" -eq 0 ] && [ "$r" -eq 0 ] && grep -qx 'CHECK licence-negatives PASS' "$tmp/st.out"; then
      echo "SELFTEST mutation-run-controls PASS"
    else
      echo "SELFTEST mutation-run-controls FAIL"; failed=1
    fi
  fi

  # (g) conformance-ingest must be red on a skip, and only because of the rule that flags a non-pass outcome (D-57). A scratch
  # copy of scripts/ is run on the outcome-skip control with --expect OUTCOME_SKIP: unmutated that expectation is met (exit 0);
  # with the lines carrying the rule marker deleted the judge no longer reports the skip, so the same run must exit 1. The
  # marker is assembled here so that this script never carries it, and the ingest script carries it on exactly one line.
  if st_want mutation-ingest-skip-red; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    tok=rule-non-
    tok="${tok}pass"
    sk="tests/gate/ingest/outcome-skip"
    if sh "$cp_dir/conformance-ingest" --outcomes tests/conformance/outcomes.def --root "$sk" --results "$sk/results.txt" --expect OUTCOME_SKIP > "$tmp/st.out" 2>&1; then r0=0; else r0=$?; fi
    st_alive=0
    if [ "$r0" -eq 0 ] && grep -qx 'EXPECT_OK' "$tmp/st.out"; then st_alive=1; fi
    before=$(grep -c "$tok" "$cp_dir/conformance-ingest" || true)
    grep -v "$tok" "$cp_dir/conformance-ingest" > "$cp_dir/conformance-ingest.mutated" || true
    mv "$cp_dir/conformance-ingest.mutated" "$cp_dir/conformance-ingest"
    after=$(grep -c "$tok" "$cp_dir/conformance-ingest" || true)
    if sh "$cp_dir/conformance-ingest" --outcomes tests/conformance/outcomes.def --root "$sk" --results "$sk/results.txt" --expect OUTCOME_SKIP > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$st_alive" -eq 1 ] && [ "$before" -eq 1 ] && [ "$after" -eq 0 ] && [ "$r" -eq 1 ]; then
      echo "SELFTEST mutation-ingest-skip-red PASS"
    else
      echo "SELFTEST mutation-ingest-skip-red FAIL"; failed=1
    fi
  fi

  # (h) conformance-flatten must refuse to release a TSV when stage 1 is dead (D-51). With a stage 1 that prints nothing, the
  # ok-two-files input must give exit 1, no byte on stdout and FLAT_NO_SENTINEL; with the real stage 1 the same input must exit
  # 0 and end in an END row, so the check is not satisfied by a flatten that always fails.
  if st_want mutation-flatten-sentinel; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    ok2="tests/gate/flatten/ok-two-files"
    if sh "$cp_dir/conformance-flatten" "$ok2" > "$tmp/st.out" 2> "$tmp/st.err"; then r0=0; else r0=$?; fi
    st_alive=0
    if [ "$r0" -eq 0 ] && [ "$(tail -n 1 "$tmp/st.out" | cut -c 1-3)" = "END" ]; then st_alive=1; fi
    echo 'BEGIN { exit 0 }' > "$cp_dir/lib/toml-subset.awk"
    if sh "$cp_dir/conformance-flatten" "$ok2" > "$tmp/st.out" 2> "$tmp/st.err"; then r=0; else r=$?; fi
    bytes=$(wc -c < "$tmp/st.out" | tr -d ' ')
    if [ "$st_alive" -eq 1 ] && [ "$r" -eq 1 ] && [ "$bytes" -eq 0 ] && grep -q 'FLAT_NO_SENTINEL' "$tmp/st.err"; then
      echo "SELFTEST mutation-flatten-sentinel PASS"
    else
      echo "SELFTEST mutation-flatten-sentinel FAIL"; failed=1
    fi
  fi

  # (i) the cancelled outcome has a producer, and the producer is the trap (D-77). The control sequence is run twice against
  # scratch copies of scripts/: the unmutated copy must pass it; with the lines carrying the trap marker deleted the same
  # sequence must be broken, because SIGTERM then kills the supervisor before it writes anything. The marker is assembled
  # here so that this script never carries it, and conformance-run carries it on exactly two lines (the INT and TERM traps).
  if st_want mutation-cancel-trap; then
    st_ran=1
    rm -rf "$cp_dir"
    cp -R "$here" "$cp_dir"
    tok=rule-cancel-
    tok="${tok}trap"
    if cancel_sequence "$cp_dir/conformance-run" "$tmp/st-cancel" > "$tmp/st.out" 2>&1; then r0=0; else r0=$?; fi
    before=$(grep -c "$tok" "$cp_dir/conformance-run" || true)
    grep -v "$tok" "$cp_dir/conformance-run" > "$cp_dir/conformance-run.mutated" || true
    mv "$cp_dir/conformance-run.mutated" "$cp_dir/conformance-run"
    after=$(grep -c "$tok" "$cp_dir/conformance-run" || true)
    if cancel_sequence "$cp_dir/conformance-run" "$tmp/st-cancel" > "$tmp/st.out" 2>&1; then r=0; else r=$?; fi
    if [ "$r0" -eq 0 ] && [ "$before" -eq 2 ] && [ "$after" -eq 0 ] && [ "$r" -eq 1 ]; then
      echo "SELFTEST mutation-cancel-trap PASS"
    else
      echo "SELFTEST mutation-cancel-trap FAIL"; failed=1
    fi
  fi

  # a selected NAME that matched no mutation is a usage error, never a vacuous pass
  if [ -n "$st_sel" ] && [ "$st_ran" -eq 0 ]; then usage; fi
  if [ "$failed" -eq 0 ]; then echo "SELFTEST RESULT PASS"; return 0; fi
  echo "SELFTEST RESULT FAIL"
  return 1
}

# ---- runner ----

# run_stage NAME FUNCTION : prints the verdict line, then any detail output indented. With --stage NAME every other stage is
# skipped and the one match is remembered, so an unknown NAME can be refused after the list instead of passing vacuously.
run_stage() {
  name=$1
  fn=$2
  if [ -n "$only_stage" ] && [ "$only_stage" != "$name" ]; then
    return 0
  fi
  stage_ran=1
  if "$fn" > "$tmp/out" 2>&1; then rc=0; else rc=$?; fi
  case $rc in
    0) verdict=PASS ;;
    1) verdict=FAIL; fails=$((fails + 1)) ;;
    *) verdict=ERROR; errs=$((errs + 1)) ;;
  esac
  echo "CHECK $name $verdict"
  if [ "$rc" -ne 0 ]; then
    sed 's/^/    /' "$tmp/out"
  fi
}

usage() {
  echo "usage: sh scripts/check [--selftest [NAME] | --stage NAME]" >&2
  exit 2
}

only_stage=""
stage_ran=0
st_sel=""
if [ $# -gt 0 ]; then
  case $1 in
    --selftest)
      [ $# -le 2 ] || usage
      st_sel=${2-}
      if [ $# -eq 2 ] && [ -z "$st_sel" ]; then usage; fi
      if selftest; then exit 0; else exit 1; fi
      ;;
    --stage)
      [ $# -eq 2 ] && [ -n "$2" ] || usage
      only_stage=$2
      ;;
    *) usage ;;
  esac
fi

run_stage ledger-entries stage_ledger_entries
run_stage ledger-negatives stage_ledger_negatives
run_stage ledger-samples stage_ledger_samples
run_stage decision-records stage_decision_records
run_stage decision-negatives stage_decision_negatives
run_stage profile-records stage_profile_records
run_stage profile-negatives stage_profile_negatives
run_stage filename-controls stage_filename_controls
run_stage empty-expect-controls stage_empty_expect_controls
run_stage provenance stage_provenance_register
run_stage provenance-negatives stage_provenance_negatives
run_stage licences stage_licence_files
run_stage licence-negatives stage_licence_negatives
run_stage protocol-order stage_protocol_order
run_stage protocol-negatives stage_protocol_negatives
run_stage score-controls stage_score_controls
run_stage results stage_results
run_stage results-negatives stage_results_negatives
run_stage ingest-controls stage_ingest_controls
run_stage flatten-controls stage_flatten_controls
run_stage cancel-controls stage_cancel_controls

if [ -n "$only_stage" ]; then
  # one stage: its own CHECK line is the whole output; the exit status is that stage's verdict
  [ "$stage_ran" -eq 1 ] || usage
  if [ "$errs" -gt 0 ]; then exit 2; fi
  if [ "$fails" -gt 0 ]; then exit 1; fi
  exit 0
fi
if [ "$errs" -gt 0 ]; then
  echo "CHECK RESULT FAIL"
  exit 2
fi
if [ "$fails" -gt 0 ]; then
  echo "CHECK RESULT FAIL"
  exit 1
fi
echo "CHECK RESULT PASS"
exit 0
