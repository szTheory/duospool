#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# conformance-run - the sh harness that drives the conformance runner (D-57, D-77). Modes: supervise (the watchdog and the
# cancelled producer) and run (the whole conformance step). Later plans add modes, and an unknown mode exits 2 with the usage
# line so that they can do so without changing this contract.
# usage: conformance-run run [--preset NAME]
#        conformance-run sanitize
#        conformance-run fixtures [--only NAME]
#        conformance-run control DIR
#        conformance-run control-signal DIR SIG
#        conformance-run supervise --ids FILE --out FILE [--wall N] -- CMD ARGS...
# run mode (D-60, D-85): everything lives under build/NAME (default gate, the build directory of the preset NAME). The steps are
#   (the runner also gets --records DIR/records, made empty on every run, and --golden-dir tests/conformance/golden: see plan 14, D-84b, D-86)
#   flatten tests/conformance/cases into cases.tsv (the only parser of hand-edited data, D-51), derive ids.txt from it, flatten the
#   frozen profiles/pce-hucard-2btn/r1.toml into r1.tsv and cut the 13 field names of scripts/lib/profile-rules.awk into
#   rules-fields.txt (both handed to the runner for the profile kinds), write oracle.tsv from tests/conformance/mirror-oracle.awk
#   (the independent bank-signature oracle, 384 rows, handed to the runner as --oracle), configure
#   and build the preset incrementally (so a stale binary is never judged), run ds_runner under the supervise mode below with
#   its stdout in results.txt, judge results.txt with conformance-ingest against tests/conformance/REQUIRED and the case
#   inventory (with --mode gate --excluded tests/conformance/EXCLUDED_IN_MODE, so that the exclusion file is validated on every gate run), run the hash sweep (hash_sweep below: the core SHA-256 against the host sha tool for every length of the runner's
#   --sweep-lengths, HASH_SWEEP_MISMATCH on a difference), run the toy controls (controls_mode below: every tests/controls/NAME
#   is a deliberately wrong core, generated from the live source by scripts/control-mutate, that the named cases must show red;
#   CONTROL NAME RED_OK, or CONTROL NAME NOT_RED and status 1), and print the RESULT lines then  STATUS conformance ok n=COUNT .
#   Violations are printed instead of the STATUS line.
#   exit 0 judged green | 1 judged red, a malformed case file or a failed build | 2 harness error (also wall expiry)
# sanitize mode (D-41, D-55, D-83): the same steps as run mode on the preset sanitize (ASan and UBSan, no recover, no -fwrapv; build/sanitize),
#   with these differences. The compiler is /usr/bin/clang on Darwin (Homebrew LLVM hangs and is never used) and cc elsewhere, passed to cmake
#   through CC; a build directory that was configured with another compiler is removed first. After the build the three planted canaries
#   (ds_canary heap, overflow, shift) are run: each must exit non-zero and print the sanitizer's own message (AddressSanitizer for heap,
#   runtime error for the two UBSan ones), printed as CANARY NAME reported; otherwise SANITIZER_DEAD NAME is printed and the status is 1.
#   Before anything is built build/gate/results.txt must exist (the conformance step makes it; exit 2 otherwise). The ids of
#   tests/conformance/EXCLUDED_IN_MODE rows for the mode sanitize go to build/sanitize/exclude-ids.txt, the runner gets them as
#   --exclude-ids, one line  EXCLUDED_IN_MODE sanitize ID  is printed per id, and the ingest runs with --mode sanitize --excluded
#   tests/conformance/EXCLUDED_IN_MODE --gate-results build/gate/results.txt (D-78: exact set; never counted as a skip).
#   Then the runner runs under the supervise mode with the wall watchdog at about 3 times the default (900 s), the hash sweep runs
#   on the sanitized runner, and the toy controls do not (they were judged in the gate preset). ASAN_OPTIONS detect_leaks=1 is exported on
#   Linux only (Apple ASan has no leak detector). The final line is STATUS sanitize ok n=COUNT.
# fixtures mode (FIX-02, D-59, D-85): flatten the cases and build the gate preset (the two producing steps of the run mode, one shared
#   function each), list the recipes the gate emits (ds_runner --fixtures), hash and measure ds_runner --emit NAME with host tools into
#   build/gate/fixtures.used (NAME SIZE SHA256) and run scripts/fixture-check on it; see fixtures_mode below. --only NAME checks one recipe
#   and passes --partial (no FIX_STALE verdict from a one-line list). exit 0 STATUS fixtures ok | 1 FIX_ codes or a failed build or case file
#   | 2 harness error
# control mode (FIX-04, RUN-02, D-58, D-77, D-80): DIR is a mini-root with tests/conformance/cases, tests/conformance/REQUIRED and an EXPECT file of
#   pairs  ID OUTCOME  (one per line, # comments and blank lines ignored). The mode flattens DIR/tests/conformance/cases, builds the gate preset
#   incrementally, runs the LIVE ds_runner on that TSV under the supervise mode (wall watchdog 60 s), prints the RESULT lines and RUNNER_DONE, and
#   keeps everything under build/gate/control/NAME (NAME = the name of DIR, results.txt is the file the ingest judges). Each pair is matched on the
#   FIELDS of the RESULT lines with awk ($1 == "RESULT" && $2 == ID && $3 == OUTCOME, the id and outcome passed through ENVIRON), never by matching a
#   whole line, because the line also carries the assertion count and the evidence path. A pair without a match is printed as
#   CONTROL_PAIR_MISSING ID OUTCOME got:OUTCOME and the status is 1; all pairs matched prints STATUS control ok pairs=N and the status is 0.
#   A missing or empty EXPECT, a pair that is not  ID OUTCOME , or a missing mini-root is exit 2 (HARNESS_NO_EXPECT, HARNESS_EMPTY_EXPECT,
#   HARNESS_BAD_EXPECT): a control that asserts nothing never passes. The mode works in the repository root of this script, or in the directory
#   named by the environment variable CONFORMANCE_RUN_ROOT (the gate's selftest runs a mutated copy of this script against the real tree).
# control-signal mode: the same run, started in the background under the supervise mode; the harness waits until the runner has printed its first
#   RESULT line (at most 10 s, else exit 2), sends SIG (INT or TERM) to the supervisor, waits for it (it must exit 1 and print CANCELLED signal:SIG),
#   reaps any runner that survived, and then checks DIR/EXPECT exactly as the control mode does (the cancelled pair is written by the supervisor).
# supervise mode:
#   --ids FILE  one case id per line (# comments and blank lines ignored): the ids that must have a RESULT line
#   --out FILE  CMD's stdout is written here (truncated first); this is the file that conformance-ingest judges
#   --wall N    wall-clock watchdog in whole seconds, default 300 (D-57: the watchdog lives in this harness, not in the runner)
# Normal end: the exit status of CMD (a status above 2 is reported as HARNESS_CMD_STATUS and becomes 2).
# SIGINT or SIGTERM (D-77): CMD is killed, every id in the ids file that has no RESULT line in OUT gets
#   RESULT ID cancelled assertions=0 evidence=signal:INT|TERM , then RUNNER_DONE n is appended (n = RESULT lines in OUT),
#   CANCELLED signal:NAME n=COUNT is printed on stdout and the exit status is 1. The ingest judges that file non-green.
# Wall expiry: the alarm kills CMD, HARNESS_WALL seconds=N is printed on stderr and the exit status is 2. That is a harness
#   error, never guest evidence and never a cancelled line, and it is not retried. The alarm is armed with perl because macOS
#   has no timeout(1); a CMD that itself dies of SIGALRM is indistinguishable from expiry and is treated the same way.
# stdout: CANCELLED signal:NAME n=COUNT on a cancelled run, otherwise nothing of its own (CMD's output goes to OUT)
# exit  : 0 CMD exited 0 | 1 CMD exited 1, or the run was cancelled | 2 usage or harness error, or wall expiry
set -eu
LC_ALL=C; export LC_ALL

here=$(cd "$(dirname "$0")" && pwd)

usage() {
  echo "usage: conformance-run run [--preset NAME] | sanitize | fixtures [--only NAME] | control DIR | control-signal DIR SIG | supervise --ids FILE --out FILE [--wall N] -- CMD ARGS..." >&2
  exit 2
}

# flatten_cases BD (D-86): the first producing step shared by the run mode and the fixtures mode. tests/conformance/cases is flattened
# (or the directory named by the optional second argument, the control mode) into BD/cases.tsv by the one parser of hand-edited data (D-51); the old file is removed first and a failed or END-less flatten leaves none,
# so a stale TSV is never read. A malformed case file gives exit 1, a harness fault exit 2.
flatten_cases() {
  fc_bd=$1
  fc_src=${2:-tests/conformance/cases}
  rm -f "$fc_bd/cases.tsv" "$fc_bd/flatten.err"
  if sh "$here/conformance-flatten" "$fc_src" > "$fc_bd/cases.tsv" 2> "$fc_bd/flatten.err"; then fc_r=0; else fc_r=$?; fi
  if [ "$fc_r" -ne 0 ]; then
    cat "$fc_bd/flatten.err"
    rm -f "$fc_bd/cases.tsv"
    [ "$fc_r" -eq 1 ] || fc_r=2
    exit "$fc_r"
  fi
}

# build_preset PRESET BD (D-86): the second producing step shared by the run mode and the fixtures mode: configure and build the preset
# incrementally, so that a stale binary is never read, and require the runner afterwards (a build that fails is BUILD_FAILED and status 1).
build_preset() {
  bp_preset=$1
  bp_bd=$2
  if cmake --preset "$bp_preset" > "$bp_bd/build.log" 2>&1 && cmake --build --preset "$bp_preset" >> "$bp_bd/build.log" 2>&1; then :; else
    cat "$bp_bd/build.log"
    echo "BUILD_FAILED preset $bp_preset"
    exit 1
  fi
  if [ ! -x "$bp_bd/ds_runner" ]; then
    echo "HARNESS_ERROR $bp_bd/ds_runner is missing after a clean build" >&2
    exit 2
  fi
}

# run_mode [--preset NAME]: the whole conformance step for one preset. Every file it produces is first removed, so that a step
# that fails can never leave an earlier good file to be judged.
run_mode() {
  mode=gate
  preset=gate
  wall_secs=300
  if [ "${1-}" = --sanitize ]; then
    mode=sanitize
    preset=sanitize
    wall_secs=900
    shift
    [ $# -eq 0 ] || usage
  fi
  while [ $# -gt 0 ]; do
    case $1 in
      --preset) [ $# -ge 2 ] || usage; preset=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  case $preset in
    '' | *[!A-Za-z0-9_-]*) usage ;;
  esac
  cd "$here/.."
  root=$(pwd)
  bd=build/$preset
  # the seed of the run-time unique markers of the redaction cases (D-56): the host clock and this process id, so that no marker is a
  # constant in any source or output; the runner takes it as --marker-seed and never calls a clock itself
  marker_seed=$(( $(date +%s) * 65536 + $$ % 65536 ))
  if [ "$mode" = sanitize ] && [ ! -f build/gate/results.txt ]; then
    echo "HARNESS_NO_GATE_RESULTS build/gate/results.txt is missing: the conformance step produces it and the sanitize mode reads it (D-78)" >&2
    exit 2
  fi
  mkdir -p "$bd" || { echo "HARNESS_ERROR cannot create $bd" >&2; exit 2; }
  rm -rf "$bd/exclude-ids.txt" "$bd/cases.tsv" "$bd/ids.txt" "$bd/results.txt" "$bd/evidence" "$bd/records" "$bd/r1.tsv" "$bd/rules-fields.txt" "$bd/oracle.tsv" "$bd/oracle.err"

  flatten_cases "$bd"
  awk -F'\t' '$1 == "K" { print $2 }' "$bd/cases.tsv" | sort -u > "$bd/ids.txt"
  if [ ! -s "$bd/ids.txt" ]; then
    echo "HARNESS_NO_CASES the flattened inventory holds no case" >&2
    exit 2
  fi
  # the exact exclusion of this mode (D-78): the ids of the rows for this mode, and the ids the supervisor must account for without them
  ex_args=""
  : > "$bd/exclude-ids.txt"
  if [ "$mode" = sanitize ]; then
    awk -v m="$mode" '/^[ \t]*(#.*)?$/ { next } NF == 2 && $1 == m { print $2 }' tests/conformance/EXCLUDED_IN_MODE > "$bd/exclude-ids.txt"
    grep -Fvx -f "$bd/exclude-ids.txt" "$bd/ids.txt" > "$bd/ids.run" || true
    mv "$bd/ids.run" "$bd/ids.txt"
    ex_args="--exclude-ids $bd/exclude-ids.txt"
  fi

  # the two inputs of the profile kinds (D-48, D-51): the frozen r1 record flattened by the same parser as the cases, and the
  # field-name list of the profile rules cut out of scripts/lib/profile-rules.awk; the runner reads lines, never TOML or awk
  if sh "$here/conformance-flatten" profiles/pce-hucard-2btn/r1.toml > "$bd/r1.tsv" 2> "$bd/r1.err"; then r=0; else r=$?; fi
  if [ "$r" -ne 0 ] || [ "$(tail -n 1 "$bd/r1.tsv" | cut -c 1-3)" != "END" ]; then
    cat "$bd/r1.err"
    rm -f "$bd/r1.tsv"
    echo "HARNESS_ERROR the flattened r1 record is missing or has no END row" >&2
    [ "$r" -eq 1 ] || r=2
    exit "$r"
  fi
  sed -n 's/^.*split("\([a-z0-9_ ]*\)", fl, " ").*$/\1/p' scripts/lib/profile-rules.awk | tr ' ' '\n' > "$bd/rules-fields.txt"
  if [ "$(sed -n '$=' "$bd/rules-fields.txt")" != 13 ] || [ "$(sed -n '/^$/p' "$bd/rules-fields.txt" | wc -l | tr -d ' ')" -ne 0 ]; then
    echo "HARNESS_ERROR the field list of scripts/lib/profile-rules.awk did not give exactly 13 names" >&2
    exit 2
  fi

  # the independent oracle of the bank signatures (D-59): tests/conformance/mirror-oracle.awk is run for each supported size
  # (KiB) before the runner starts and its rows go to oracle.tsv, which the runner reads with --oracle; the awk script shares no
  # code or table with the core
  : > "$bd/oracle.tsv"
  for ks in 256 384 1024; do
    if awk -v size="$ks" -f tests/conformance/mirror-oracle.awk >> "$bd/oracle.tsv" 2>> "$bd/oracle.err"; then :; else
      cat "$bd/oracle.err"
      rm -f "$bd/oracle.tsv"
      exit 1
    fi
  done
  if [ "$(sed -n '$=' "$bd/oracle.tsv")" != 384 ]; then
    echo "HARNESS_ERROR the oracle did not give exactly 384 rows (128 banks for each of 3 sizes)" >&2
    exit 2
  fi

  if [ "$mode" = sanitize ]; then
    sanitize_compiler "$bd"
  fi
  build_preset "$preset" "$bd"
  if [ "$mode" = sanitize ]; then
    canary_check "$bd"
  fi

  mkdir -p "$bd/evidence" || { echo "HARNESS_ERROR cannot create $bd/evidence" >&2; exit 2; }
  # the records of the run (D-84b, D-86): the one directory the runner writes records into. It is made here, empty, on every run (stale files were
  # removed above), so the record-lint stage never reads a directory left by an earlier run; the runner writes DIR/ID.record.toml for every case of
  # kind accept, record_lines, record_golden or record_refusal and creates nothing else. The goldens are read from tests/conformance/golden.
  mkdir -p "$bd/records" || { echo "HARNESS_ERROR cannot create $bd/records" >&2; exit 2; }
  if sh "$here/conformance-run" supervise --ids "$bd/ids.txt" --out "$bd/results.txt" --wall "$wall_secs" -- "$bd/ds_runner" --cases "$bd/cases.tsv" --evidence-dir "$bd/evidence" --profile-tsv "$bd/r1.tsv" --rules-fields "$bd/rules-fields.txt" --oracle "$bd/oracle.tsv" --marker-seed "$marker_seed" --records "$bd/records" --golden-dir tests/conformance/golden $ex_args; then sup=0; else sup=$?; fi
  if [ "$sup" -eq 2 ]; then
    exit 2
  fi

  grep -E '^(RESULT|RUNNER_DONE) ' "$bd/results.txt" || true
  # the exclusion lines are this script's (D-80): the runner prints only RESULT and RUNNER_DONE
  while IFS= read -r ex_id; do
    echo "EXCLUDED_IN_MODE $mode $ex_id"
  done < "$bd/exclude-ids.txt"
  if [ "$mode" = sanitize ]; then
    ing_mode="--mode sanitize --gate-results build/gate/results.txt"
  else
    ing_mode="--mode gate"
  fi
  if sh "$here/conformance-ingest" --root "$root" --results "$bd/results.txt" --required tests/conformance/REQUIRED --inventory tests/conformance/cases --excluded tests/conformance/EXCLUDED_IN_MODE $ing_mode > "$bd/ingest.out" 2>&1; then ing=0; else ing=$?; fi
  if [ "$ing" -ne 0 ]; then
    cat "$bd/ingest.out"
    exit "$ing"
  fi
  if [ "$sup" -ne 0 ]; then
    echo "CONFORMANCE_RUNNER_STATUS $sup"
    exit 1
  fi
  hash_sweep "$bd/ds_runner"
  n=$(grep -c '^RESULT ' "$bd/results.txt" || true)
  if [ "$mode" = sanitize ]; then
    echo "STATUS sanitize ok n=$n"
    exit 0
  fi
  controls_mode "$preset" "$bd"
  echo "STATUS conformance ok n=$n"
  exit 0
}

# sanitize_compiler BD (D-55): choose the compiler of the sanitize preset and export it as CC. Darwin: /usr/bin/clang, because Homebrew
# LLVM hangs with ASan on this macOS. Elsewhere: cc. A build directory that was configured with another compiler is removed first
# (cmake keeps the compiler of an existing cache), and on Linux ASAN_OPTIONS gets detect_leaks=1 (Apple ASan has no leak detector).
sanitize_compiler() {
  sc_bd=$1
  case $(uname -s) in
    Darwin) CC=/usr/bin/clang ;;
    *) CC=cc ;;
  esac
  if ! command -v "$CC" > /dev/null 2>&1; then
    echo "HARNESS_ERROR the sanitizer compiler $CC is not available" >&2
    exit 2
  fi
  export CC
  if [ -f "$sc_bd/CMakeCache.txt" ] && [ "$CC" = /usr/bin/clang ] && ! grep -Fxq "CMAKE_C_COMPILER:FILEPATH=/usr/bin/clang" "$sc_bd/CMakeCache.txt"; then
    rm -rf "$sc_bd"
    mkdir -p "$sc_bd" || { echo "HARNESS_ERROR cannot create $sc_bd" >&2; exit 2; }
  fi
  if [ "$(uname -s)" = Linux ]; then
    ASAN_OPTIONS=detect_leaks=1
    export ASAN_OPTIONS
  fi
  echo "SANITIZER_COMPILER $CC"
}

# canary_check BD (D-55, D-83): the sanitizers are shown alive before the runner is judged under them. Each of the three planted
# defects of ds_canary must end non-zero with the sanitizer's own message: heap -> AddressSanitizer, overflow and shift -> runtime
# error (UBSan, which can only see the signed overflow because the sanitize preset carries no -fwrapv). The first runtime error line
# is shown, cut to a repository-relative path. A canary that does not report is SANITIZER_DEAD NAME, and the status is 1 after all three ran.
canary_check() {
  cc_bd=$1
  cc_dead=0
  if [ ! -x "$cc_bd/ds_canary" ]; then
    echo "HARNESS_ERROR $cc_bd/ds_canary is missing after the build" >&2
    exit 2
  fi
  for cc_spec in heap:AddressSanitizer overflow:'runtime error' shift:'runtime error'; do
    cc_name=${cc_spec%%:*}
    cc_want=${cc_spec#*:}
    # an inner sh runs the canary, so that the shell's own "Abort trap" notice of the aborted child stays out of the output
    cc_r=$(sh -c '"$0" "$1" > "$2" 2>&1; echo $?' "$cc_bd/ds_canary" "$cc_name" "$cc_bd/canary-$cc_name.txt" 2> /dev/null) || cc_r=2
    if [ "$cc_r" -ne 0 ] && grep -Fq -e "$cc_want" "$cc_bd/canary-$cc_name.txt"; then
      echo "CANARY $cc_name reported exit=$cc_r"
      if [ "$cc_name" != heap ]; then
        grep -F -m 1 -e "runtime error" "$cc_bd/canary-$cc_name.txt" | sed 's|^.*/tests/|tests/|; s/^/  /'
      fi
    else
      echo "SANITIZER_DEAD $cc_name"
      cc_dead=1
    fi
  done
  if [ "$cc_dead" -ne 0 ]; then
    exit 1
  fi
}

# controls_mode PRESET BD (D-85, D-55): the liveness controls of the matrix, run after it. Every tests/controls/NAME/ holds a RULE
# and an EXPECT. For each one: scripts/control-mutate makes the toy source from the LIVE file named by the rule (an anchor count
# other than one is a harness error, exit 2), the toy target ds_toy_NAME is built from it (a toy that does not compile is a harness
# error, never red), the toy runner runs the same cases TSV, oracle and profile inputs as the real one, and every case id of EXPECT
# must have a RESULT line whose id and outcome FIELDS are that id and guest_failure (awk field match, never a whole-line match) and
# the toy's RUNNER_DONE must be present. Printed: CONTROL NAME RED_OK, or CONTROL NAME NOT_RED (the stage then ends with status 1,
# after every control has run). The toy runner prints only RESULT and RUNNER_DONE lines; these lines are this script's (D-80).
# A missing or empty EXPECT, an id that no case carries, or no control at all is a harness error or a dead gate, never a pass.
# The lines also go to BD/controls.txt.
controls_mode() {
  cm_preset=$1
  cm_bd=$2
  cm_red=0
  cm_n=0
  rm -rf "$cm_bd/controls" "$cm_bd/controls.txt"
  mkdir -p "$cm_bd/controls" || { echo "HARNESS_ERROR cannot create $cm_bd/controls" >&2; exit 2; }
  : > "$cm_bd/controls.txt"
  # first the inputs of every control, so that a bad one is reported before any build starts
  for cm_dir in tests/controls/*/; do
    [ -d "$cm_dir" ] || continue
    cm_name=$(basename "$cm_dir")
    cm_n=$((cm_n + 1))
    case $cm_name in
      '' | *[!A-Za-z0-9_-]*) echo "HARNESS_ERROR the control directory name '$cm_name' is outside A-Z a-z 0-9 _ -" >&2; exit 2 ;;
    esac
    if [ ! -f "${cm_dir}RULE" ]; then
      echo "HARNESS_NO_RULE $cm_name" >&2
      exit 2
    fi
    if [ ! -f "${cm_dir}EXPECT" ]; then
      echo "HARNESS_NO_EXPECT $cm_name" >&2
      exit 2
    fi
    awk '/^[ \t]*(#.*)?$/ { next } { print $1 }' "${cm_dir}EXPECT" > "$cm_bd/controls/$cm_name.ids"
    if [ ! -s "$cm_bd/controls/$cm_name.ids" ]; then
      echo "HARNESS_EMPTY_EXPECT $cm_name" >&2
      exit 2
    fi
    while IFS= read -r cm_id; do
      case $cm_id in
        '' | *[!A-Za-z0-9_]*) echo "HARNESS_ERROR $cm_name: EXPECT id '$cm_id' is outside A-Z a-z 0-9 _" >&2; exit 2 ;;
      esac
      if ! grep -Fxq -e "$cm_id" "$cm_bd/ids.txt"; then
        echo "HARNESS_ERROR $cm_name: EXPECT names '$cm_id', which no case carries" >&2
        exit 2
      fi
    done < "$cm_bd/controls/$cm_name.ids"
  done
  if [ "$cm_n" -eq 0 ]; then
    echo "NO_CONTROLS tests/controls"
    exit 1
  fi
  for cm_dir in tests/controls/*/; do
    [ -d "$cm_dir" ] || continue
    cm_name=$(basename "$cm_dir")
    cm_file=$(sed -n 's/^file=//p' "${cm_dir}RULE")
    cm_src="$cm_bd/controls/$cm_name/$(basename "$cm_file")"
    if sh "$here/control-mutate" "${cm_dir}RULE" "$cm_src" > "$cm_bd/controls/$cm_name.mutate" 2>&1; then :; else
      cm_r=$?
      cat "$cm_bd/controls/$cm_name.mutate"
      [ "$cm_r" -eq 2 ] || cm_r=2
      exit "$cm_r"
    fi
    if cmake --build --preset "$cm_preset" --target "ds_toy_$cm_name" > "$cm_bd/controls/$cm_name.build" 2>&1; then :; else
      cat "$cm_bd/controls/$cm_name.build"
      echo "HARNESS_ERROR CONTROL_BUILD_FAILED $cm_name: the toy does not compile, which is a broken control and not a red one" >&2
      exit 2
    fi
    if [ ! -x "$cm_bd/ds_toy_$cm_name" ]; then
      echo "HARNESS_ERROR $cm_bd/ds_toy_$cm_name is missing after its build" >&2
      exit 2
    fi
    mkdir -p "$cm_bd/controls/$cm_name/evidence" || { echo "HARNESS_ERROR cannot create the evidence directory of $cm_name" >&2; exit 2; }
    cm_out="$cm_bd/controls/$cm_name/results.txt"
    # the toy fails cases on purpose, so a runner status of 1 is expected here; only a harness status (2) stops the run
    if sh "$here/conformance-run" supervise --ids "$cm_bd/ids.txt" --out "$cm_out" -- "$cm_bd/ds_toy_$cm_name" --cases "$cm_bd/cases.tsv" --evidence-dir "$cm_bd/controls/$cm_name/evidence" --profile-tsv "$cm_bd/r1.tsv" --rules-fields "$cm_bd/rules-fields.txt" --oracle "$cm_bd/oracle.tsv" --marker-seed "$marker_seed" --golden-dir tests/conformance/golden > /dev/null 2> "$cm_bd/controls/$cm_name/stderr.txt"; then cm_sup=0; else cm_sup=$?; fi
    if [ "$cm_sup" -ge 2 ]; then
      cat "$cm_bd/controls/$cm_name/stderr.txt" >&2
      echo "HARNESS_ERROR the toy runner of $cm_name ended with a harness status ($cm_sup)" >&2
      exit 2
    fi
    cm_ok=1
    cm_why=""
    if ! awk '$1 == "RUNNER_DONE" { f = 1 } END { exit !f }' "$cm_out"; then
      cm_ok=0
      cm_why="no RUNNER_DONE line"
    fi
    while IFS= read -r cm_id; do
      if ! awk -v id="$cm_id" '$1 == "RESULT" && $2 == id && $3 == "guest_failure" { f = 1 } END { exit !f }' "$cm_out"; then
        cm_ok=0
        cm_why="$cm_why $cm_id:$(awk -v id="$cm_id" '$1 == "RESULT" && $2 == id { print $3; f = 1; exit } END { if (!f) print "no-result" }' "$cm_out")"
      fi
    done < "$cm_bd/controls/$cm_name.ids"
    if [ "$cm_ok" -eq 1 ]; then
      echo "CONTROL $cm_name RED_OK" | tee -a "$cm_bd/controls.txt"
    else
      echo "CONTROL $cm_name NOT_RED" | tee -a "$cm_bd/controls.txt"
      echo "  expected guest_failure; got:$cm_why"
      cm_red=1
    fi
  done
  if [ "$cm_red" -ne 0 ]; then
    exit 1
  fi
}

# pick_sha_tool: choose the host SHA-256 tool once and set sha_tool: sha256sum if present, else shasum -a 256 (D-60). The tool shares no
# code, language or author with the core. Neither present is a harness error (exit 2).
pick_sha_tool() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha_tool=sha256sum
  elif command -v shasum > /dev/null 2>&1; then
    sha_tool="shasum -a 256"
  else
    echo "HARNESS_ERROR neither sha256sum nor shasum is available" >&2
    exit 2
  fi
}

# fixtures_mode [--only NAME] (FIX-02, D-59, D-85, D-86): make the used list of the fixture manifest and run scripts/fixture-check on it.
# It performs the same two producing steps as the run mode (flatten_cases, build_preset on the gate preset), so it never reads a stale
# TSV or binary and needs no earlier stage. Then, for every line of  ds_runner --cases build/gate/cases.tsv --fixtures  (or only NAME), it
# measures the bytes of  ds_runner --emit NAME  with host tools only: the SHA-256 from the sha tool chosen once, the size from wc -c; the
# runner's own size column must agree with the measured one. The lines  NAME SIZE SHA256  go to build/gate/fixtures.used, which is removed
# first and never read from an earlier run. An --only run is a partial list: fixture-check gets --partial, so the one-recipe list is not
# read as a verdict on the other entries (FIX_STALE); a run without --only never passes it. The exit status and the output are the
# checker's (0 STATUS fixtures ok, 1 FIX_ codes, 2 harness error).
fixtures_mode() {
  fm_only=""
  while [ $# -gt 0 ]; do
    case $1 in
      --only) [ $# -ge 2 ] || usage; fm_only=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  case $fm_only in
    *[!a-z0-9:-]*) usage ;;
  esac
  cd "$here/.."
  fm_bd=build/gate
  mkdir -p "$fm_bd" || { echo "HARNESS_ERROR cannot create $fm_bd" >&2; exit 2; }
  rm -f "$fm_bd/fixtures.used" "$fm_bd/fixtures.list"
  flatten_cases "$fm_bd"
  build_preset gate "$fm_bd"
  pick_sha_tool
  if "$fm_bd/ds_runner" --cases "$fm_bd/cases.tsv" --fixtures > "$fm_bd/fixtures.list" 2> "$fm_bd/fixtures.err"; then :; else
    cat "$fm_bd/fixtures.err" >&2
    echo "HARNESS_ERROR the runner could not list its fixtures" >&2
    exit 2
  fi
  if [ ! -s "$fm_bd/fixtures.list" ]; then
    echo "HARNESS_ERROR the runner listed no fixture" >&2
    exit 2
  fi
  : > "$fm_bd/fixtures.used"
  fm_partial=""
  if [ -n "$fm_only" ]; then
    fm_partial=--partial
    if ! awk -v n="$fm_only" '$1 == n { f = 1 } END { exit !f }' "$fm_bd/fixtures.list"; then
      echo "HARNESS_ERROR --only names a recipe that the runner does not list: $fm_only" >&2
      exit 2
    fi
  fi
  while read -r fm_name fm_size; do
    if [ -n "$fm_only" ] && [ "$fm_name" != "$fm_only" ]; then
      continue
    fi
    # the emit must succeed on its own: a failure inside a pipeline would read as the digest of an empty image
    "$fm_bd/ds_runner" --emit "$fm_name" > /dev/null || { echo "HARNESS_ERROR ds_runner --emit $fm_name failed" >&2; exit 2; }
    fm_sha=$("$fm_bd/ds_runner" --emit "$fm_name" | $sha_tool | awk '{ print $1 }')
    fm_bytes=$("$fm_bd/ds_runner" --emit "$fm_name" | wc -c | tr -d ' ')
    case $fm_sha in
      '' | *[!0-9a-f]*) echo "HARNESS_ERROR the host sha tool gave no digest for $fm_name" >&2; exit 2 ;;
    esac
    if [ "${#fm_sha}" -ne 64 ]; then
      echo "HARNESS_ERROR the host sha tool gave a digest of the wrong length for $fm_name" >&2
      exit 2
    fi
    if [ "$fm_bytes" != "$fm_size" ]; then
      echo "HARNESS_ERROR the runner lists $fm_name at $fm_size bytes but --emit wrote $fm_bytes" >&2
      exit 2
    fi
    printf '%s %s %s\n' "$fm_name" "$fm_bytes" "$fm_sha" >> "$fm_bd/fixtures.used"
  done < "$fm_bd/fixtures.list"
  if [ ! -s "$fm_bd/fixtures.used" ]; then
    echo "HARNESS_ERROR the used list is empty" >&2
    exit 2
  fi
  exec sh "$here/fixture-check" $fm_partial --used "$fm_bd/fixtures.used"
}

# result_outcome ID FILE: the outcome field of the RESULT line of ID in FILE, or no-result (diagnostics only; the verdict is field_match)
result_outcome() {
  ID=$1 awk 'BEGIN { id = ENVIRON["ID"] } $1 == "RESULT" && $2 == id { print $3; f = 1; exit } END { if (!f) print "no-result" }' "$2"
}

# field_match ID OUTCOME FILE: succeeds when FILE holds a RESULT line whose first three fields are RESULT, ID and OUTCOME (D-80). The fields are compared
# one by one with awk, the id and the outcome passed through ENVIRON; the rest of the line (assertions, evidence path) is never part of the match.
field_match() {
  ID=$1 OC=$2 awk 'BEGIN { id = ENVIRON["ID"]; oc = ENVIRON["OC"] } $1 == "RESULT" && $2 == id && $3 == oc { f = 1 } END { exit !f }' "$3"
}

# ctl_reap CASES: kill any runner that still has the control's TSV on its command line (the supervisor kills it on a signal; this is the belt
# and braces that guarantees a control never leaves a spinning process behind). pgrep is optional here: the stage that drives the mode checks too.
ctl_reap() {
  command -v pgrep > /dev/null 2>&1 || return 0
  for ctl_p in $(pgrep -f "ds_runner --cases $1" 2> /dev/null || true); do
    kill "$ctl_p" 2> /dev/null || true
  done
  return 0
}

# control_mode DIR [SIG]: see the header. Everything is made here (the flatten, the build, the run), so no stale file is ever judged.
control_mode() {
  ctl_arg=${1-}
  ctl_sig=${2-}
  [ -n "$ctl_arg" ] || usage
  case $ctl_sig in
    '' | INT | TERM) ;;
    *) usage ;;
  esac
  [ -d "$ctl_arg" ] || { echo "HARNESS_NO_FILE the control directory $ctl_arg" >&2; exit 2; }
  ctl_dir=$(cd "$ctl_arg" && pwd)
  ctl_name=$(basename "$ctl_dir")
  case $ctl_name in
    '' | *[!A-Za-z0-9_-]*) echo "HARNESS_ERROR the control directory name '$ctl_name' is outside A-Z a-z 0-9 _ -" >&2; exit 2 ;;
  esac
  cd "${CONFORMANCE_RUN_ROOT:-$here/..}"
  if [ ! -f "$ctl_dir/EXPECT" ]; then
    echo "HARNESS_NO_EXPECT $ctl_name" >&2
    exit 2
  fi
  if ! awk '/^[ \t]*(#.*)?$/ { next } { n++ } END { exit !(n > 0) }' "$ctl_dir/EXPECT"; then
    echo "HARNESS_EMPTY_EXPECT $ctl_name" >&2
    exit 2
  fi
  if ! awk '/^[ \t]*(#.*)?$/ { next } NF != 2 || $1 !~ /^[a-z][a-z0-9_]*$/ || $2 !~ /^[a-z_]+$/ { bad = 1 } END { exit bad ? 1 : 0 }' "$ctl_dir/EXPECT"; then
    echo "HARNESS_BAD_EXPECT $ctl_name: every line must be  ID OUTCOME" >&2
    exit 2
  fi
  ctl_wd=build/gate/control/$ctl_name
  rm -rf "$ctl_wd"
  mkdir -p "$ctl_wd/evidence" || { echo "HARNESS_ERROR cannot create $ctl_wd" >&2; exit 2; }
  flatten_cases "$ctl_wd" "$ctl_dir/tests/conformance/cases"
  awk -F'\t' '$1 == "K" { print $2 }' "$ctl_wd/cases.tsv" | sort -u > "$ctl_wd/ids.txt"
  if [ ! -s "$ctl_wd/ids.txt" ]; then
    echo "HARNESS_NO_CASES the control $ctl_name holds no case" >&2
    exit 2
  fi
  mkdir -p build/gate || { echo "HARNESS_ERROR cannot create build/gate" >&2; exit 2; }
  build_preset gate build/gate
  ctl_seed=$(( $(date +%s) * 65536 + $$ % 65536 ))
  ctl_out=$ctl_wd/results.txt
  if [ -z "$ctl_sig" ]; then
    if sh "$here/conformance-run" supervise --ids "$ctl_wd/ids.txt" --out "$ctl_out" --wall 60 -- build/gate/ds_runner --cases "$ctl_wd/cases.tsv" --evidence-dir "$ctl_wd/evidence" --marker-seed "$ctl_seed" > "$ctl_wd/sup.out" 2> "$ctl_wd/sup.err"; then ctl_sup=0; else ctl_sup=$?; fi
  else
    sh "$here/conformance-run" supervise --ids "$ctl_wd/ids.txt" --out "$ctl_out" --wall 60 -- build/gate/ds_runner --cases "$ctl_wd/cases.tsv" --evidence-dir "$ctl_wd/evidence" --marker-seed "$ctl_seed" > "$ctl_wd/sup.out" 2> "$ctl_wd/sup.err" &
    ctl_pid=$!
    ctl_i=0
    while [ "$ctl_i" -lt 100 ] && ! grep -q '^RESULT ' "$ctl_out" 2> /dev/null; do
      sleep 0.1
      ctl_i=$((ctl_i + 1))
    done
    if [ "$ctl_i" -ge 100 ]; then
      kill "$ctl_pid" 2> /dev/null || true
      wait "$ctl_pid" 2> /dev/null || true
      ctl_reap "$ctl_wd/cases.tsv"
      echo "HARNESS_ERROR the runner of $ctl_name printed no RESULT line within 10 s, so it was never signalled" >&2
      exit 2
    fi
    kill -s "$ctl_sig" "$ctl_pid"
    if wait "$ctl_pid"; then ctl_sup=0; else ctl_sup=$?; fi
    ctl_reap "$ctl_wd/cases.tsv"
    if [ "$ctl_sup" -ne 1 ] || ! grep -q "^CANCELLED signal:$ctl_sig n=" "$ctl_wd/sup.out"; then
      cat "$ctl_wd/sup.err" >&2
      echo "HARNESS_ERROR the supervisor of $ctl_name did not end as cancelled by $ctl_sig (exit $ctl_sup)" >&2
      exit 2
    fi
  fi
  if [ "$ctl_sup" -ge 2 ]; then
    cat "$ctl_wd/sup.err" >&2
    echo "HARNESS_ERROR the runner of $ctl_name ended with a harness status ($ctl_sup)" >&2
    exit 2
  fi
  grep -E '^(RESULT|RUNNER_DONE) ' "$ctl_out" || true
  ctl_miss=0
  ctl_pairs=0
  while read -r ctl_id ctl_oc; do
    case $ctl_id in '' | '#'*) continue ;; esac
    ctl_pairs=$((ctl_pairs + 1))
    field_match "$ctl_id" "$ctl_oc" "$ctl_out" || { ctl_miss=$((ctl_miss + 1)); echo "CONTROL_PAIR_MISSING $ctl_id $ctl_oc got:$(result_outcome "$ctl_id" "$ctl_out")"; } # rule-field-match
  done < "$ctl_dir/EXPECT"
  if [ "$ctl_pairs" -eq 0 ]; then
    echo "HARNESS_EMPTY_EXPECT $ctl_name" >&2
    exit 2
  fi
  if [ "$ctl_miss" -ne 0 ]; then
    exit 1
  fi
  echo "STATUS control ok pairs=$ctl_pairs"
  exit 0
}

# hash_sweep RUNNER (D-47, D-59): the independent check of the in-house SHA-256. For every length the runner prints with
# --sweep-lengths (the one definition of the list), the bytes of the synthetic image len:N go from the runner's --emit through the
# host sha tool (sha256sum if present, else shasum -a 256, chosen once), and the 64-hex digest field is compared with the one the
# core computes (--hash len:N). The host tool shares no code, language or author with the core; a difference prints
# HASH_SWEEP_MISMATCH with the length and ends the stage with status 1. A missing tool or an unusable answer is a harness error.
hash_sweep() {
  hs_runner=$1
  pick_sha_tool
  hs_tool=$sha_tool
  hs_lens=$("$hs_runner" --sweep-lengths) || { echo "HARNESS_ERROR the runner gave no sweep lengths" >&2; exit 2; }
  hs_n=0
  hs_bad=0
  for hs_len in $hs_lens; do
    hs_host=$("$hs_runner" --emit "len:$hs_len" | $hs_tool | awk '{ print $1 }')
    hs_core=$("$hs_runner" --hash "len:$hs_len") || { echo "HARNESS_ERROR the runner could not hash len:$hs_len" >&2; exit 2; }
    case $hs_host in
      '' | *[!0-9a-f]*) echo "HARNESS_ERROR the host sha tool gave no digest for len:$hs_len" >&2; exit 2 ;;
    esac
    if [ "${#hs_host}" -ne 64 ]; then
      echo "HARNESS_ERROR the host sha tool gave a digest of the wrong length for len:$hs_len" >&2
      exit 2
    fi
    if [ "$hs_host" != "$hs_core" ]; then
      echo "HASH_SWEEP_MISMATCH length=$hs_len core=$hs_core host=$hs_host"
      hs_bad=$((hs_bad + 1))
    fi
    hs_n=$((hs_n + 1))
  done
  if [ "$hs_n" -eq 0 ]; then
    echo "HARNESS_ERROR the hash sweep ran no length" >&2
    exit 2
  fi
  if [ "$hs_bad" -ne 0 ]; then
    exit 1
  fi
  echo "STATUS hash-sweep ok lengths=$hs_n"
}

[ $# -ge 1 ] || usage
case $1 in
  run) shift; run_mode "$@" ;;
  sanitize) shift; run_mode --sanitize "$@" ;;
  fixtures) shift; fixtures_mode "$@" ;;
  control) shift; [ $# -eq 1 ] || usage; control_mode "$1" ;;
  control-signal) shift; [ $# -eq 2 ] || usage; control_mode "$1" "$2" ;;
  supervise) shift ;;
  *) usage ;;
esac

ids=""
out=""
wall=300
while [ $# -gt 0 ]; do
  case $1 in
    --ids) [ $# -ge 2 ] || usage; ids=$2; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
    --wall) [ $# -ge 2 ] || usage; wall=$2; shift 2 ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
[ -n "$ids" ] && [ -n "$out" ] && [ $# -ge 1 ] || usage
case $wall in
  '' | *[!0-9]*) usage ;;
esac
[ "$wall" -gt 0 ] || usage
if [ ! -f "$ids" ]; then
  echo "HARNESS_NO_FILE $ids" >&2
  exit 2
fi

pid=""

# on_signal NAME: the cancelled producer. Kill CMD, then give every id that has no RESULT line a cancelled line whose evidence
# names the signal, close the file with RUNNER_DONE and exit 1. It is installed for INT and TERM by the two trap lines below.
on_signal() {
  sig=$1
  trap '' INT TERM
  if [ -n "$pid" ]; then
    kill "$pid" 2> /dev/null || true
    wait "$pid" 2> /dev/null || true
  fi
  # CMD may have been killed mid-line: close the partial line so that what follows starts on its own line
  if [ -s "$out" ] && [ "$(tail -c 1 "$out" | wc -l | tr -d ' ')" -eq 0 ]; then
    printf '\n' >> "$out"
  fi
  awk '/^[ \t]*(#.*)?$/ { next } { print $1 }' "$ids" > "$out.ids"
  awk '$1 == "RESULT" { print $2 }' "$out" > "$out.have"
  while IFS= read -r id; do
    if ! grep -Fxq -e "$id" "$out.have"; then
      printf 'RESULT %s cancelled assertions=0 evidence=signal:%s\n' "$id" "$sig" >> "$out"
    fi
  done < "$out.ids"
  n=$(grep -c '^RESULT ' "$out" || true)
  printf 'RUNNER_DONE %s\n' "$n" >> "$out"
  rm -f "$out.ids" "$out.have"
  echo "CANCELLED signal:$sig n=$n"
  exit 1
}

: > "$out"
trap 'on_signal TERM' TERM # rule-cancel-trap
trap 'on_signal INT' INT # rule-cancel-trap

perl -e 'alarm shift; exec @ARGV' "$wall" "$@" > "$out" &
pid=$!
if wait "$pid"; then r=0; else r=$?; fi
pid=""

if [ "$r" -eq 142 ]; then
  echo "HARNESS_WALL seconds=$wall" >&2
  exit 2
fi
if [ "$r" -gt 2 ]; then
  echo "HARNESS_CMD_STATUS $r" >&2
  exit 2
fi
exit "$r"
