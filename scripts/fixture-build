#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# fixture-build - assemble the authored HuCard fixtures in the gate; no ROM-like binary is ever committed (D-123, D-133).
# usage: fixture-build [--src DIR] [--out DIR]     (--src defaults to fixtures/src, --out to build/gate; run from the repository root or anywhere)
#   For every SRC/*.s: ca65 --cpu huc6280 -D ROMBANKS=32 -I fixtures/lib into OUT/fx/STEM.o, then ld65 -C fixtures/lib/hucard.cfg -D ROMBANKS=32
#   into OUT/fixtures/NAME.pce, where NAME is the stem with every underscore turned into a hyphen (a used-list name has no underscore, F2).
#   A variants list (STEM NAME ROMBANKS FLAGS lines, in this script) adds one more image per line from the same source with its own ROMBANKS (given to both tools, so the image is ROMBANKS * 8 KiB) and extra ca65 flags: the
#   protocol controls of ds_proto (plan 03-05, 32 banks) and the 384 KiB and 1 MiB images of mmu_mpr (plan 03-20, 48 and 128 banks). Every image is hashed and measured with host tools only (the SHA-256 tool the gate picks,
#   wc -c) and one line  NAME SIZE SHA256  per image is written to OUT/fixtures-authored.used. That second file belongs to this script alone:
#   the synthetic list OUT/fixtures.used stays with the fixtures mode of conformance-run (F3). Everything this script makes is removed first, so a stale image is never read.
#   Beside every image it writes OUT/fixtures/NAME.observe, the observe rows of the fixture's .checks file (write_observe below; plan 03-10).
#   Assembler identity is by behaviour (the encoding matrix of a later plan and the image hash pins), never by --version: the V2.19 tag prints
#   V2.18 (D-128).
# stdout: PREFLIGHT_MISSING NAME for each missing tool, or on success the marker line  STATUS fixture-build ok n=N
# exit  : 0 built | 1 an assembler or linker error, or no source | 2 a tool is missing or a harness error (never a skip, D-123)
# Before anything external runs, the tool check uses only shell builtins, so an empty PATH still reports the missing tools and exits 2.
set -eu
LC_ALL=C; export LC_ALL

missing=0
for tool in ca65 ld65; do
  if ! command -v "$tool" > /dev/null 2>&1; then
    echo "PREFLIGHT_MISSING $tool"
    missing=$((missing + 1))
  fi
done
if [ "$missing" -gt 0 ]; then
  exit 2
fi

case $0 in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
here=$(cd "$here" && pwd)
root=$(cd "$here/.." && pwd)

usage() {
  echo "usage: fixture-build [--src DIR] [--out DIR]" >&2
  exit 2
}

# the variants list: STEM NAME ROMBANKS FLAGS, one image per line, built from fixtures/src/STEM.s with its own ROMBANKS and the extra ca65 flags (plan 03-05, D-124; the ROMBANKS column is plan 03-20, D-127). NAME is a-z 0-9 and hyphens
# (F2) and ROMBANKS a number of 8 KiB banks; a stem with no line here has only its own image (32 banks). The four ds-proto variants are the DSV1 protocol controls (see fixtures/lib/verdict.inc); the two mmu-mpr variants are the
# 384 KiB and 1 MiB images of the memory-map fixture, whose literals that differ by image size come from conditional assembly on ROMBANKS in the one source.
variants='ds_proto ds-proto-predone 32 -D DSV_PREDONE
ds_proto ds-proto-nodone 32 -D DSV_NODONE
ds_proto ds-proto-badsum 32 -D DSV_BADSUM
ds_proto ds-proto-wrongid 32 -D DSV_WRONGID
mmu_mpr mmu-mpr-384k 48
mmu_mpr mmu-mpr-1m 128'

src=$root/fixtures/src
out=$root/build/gate
while [ $# -gt 0 ]; do
  case $1 in
    --src) [ $# -ge 2 ] || usage; src=$2; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
    *) usage ;;
  esac
done

if command -v sha256sum > /dev/null 2>&1; then
  sha_tool=sha256sum
elif command -v shasum > /dev/null 2>&1; then
  sha_tool="shasum -a 256"
else
  echo "HARNESS_ERROR neither sha256sum nor shasum is available" >&2
  exit 2
fi
[ -d "$src" ] || { echo "HARNESS_NO_FILE $src" >&2; exit 2; }
lib=$root/fixtures/lib
[ -f "$lib/hucard.cfg" ] || { echo "HARNESS_NO_FILE $lib/hucard.cfg" >&2; exit 2; }

rm -rf "$out/fx" "$out/fixtures" "$out/fixtures-authored.used"
mkdir -p "$out/fx" "$out/fixtures" || { echo "HARNESS_ERROR cannot create $out" >&2; exit 2; }
: > "$out/fixtures-authored.used"

# write_observe STEM NAME (plan 03-10; D-126): OUT/fixtures/NAME.observe lists, one decimal check index per line in ascending order, the rows of SRC/STEM.checks whose optional fifth column is
# the word observe (a check whose expected value legitimately differs by case: the guest writes its observed byte and result $50). The file is empty for a fixture with no such row. The runner reads it:
# the guest kind needs an observe=IDX:VALUE item for every index, and the mutation sweep must be told to exclude exactly these indexes. A missing .checks file, a fifth column other than observe,
# a sixth column or an index that is not a number is a harness error (exit 2), never an empty list. awk runs with its status tested and nothing on the left of a pipe (CR-01).
write_observe() {
  wo_checks=$src/$1.checks
  [ -f "$wo_checks" ] || { echo "HARNESS_NO_FILE $wo_checks" >&2; exit 2; }
  if awk -F '\t' '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    /^[a-z_]+=/ { next }
    NF >= 5 { if (NF > 5 || $5 != "observe" || $1 !~ /^[0-9]+$/ || ($1 + 0) < 1) { bad = 1; next } print $1 + 0 }
    END { exit bad }
  ' "$wo_checks" > "$out/fx/$2.observe.raw" && sort -n -u "$out/fx/$2.observe.raw" > "$out/fixtures/$2.observe"; then
    :
  else
    echo "HARNESS_ERROR $wo_checks has a row with a fifth column other than observe, a sixth column or a bad index"
    exit 2
  fi
}

# build_one STEM NAME ROMBANKS [ca65 flags...]: assemble SRC/STEM.s with ROMBANKS banks and link it into OUT/fixtures/NAME.pce, then hash and measure the image and append its used-list line
build_one() {
  b_stem=$1
  b_name=$2
  b_banks=$3
  shift 3
  if ca65 --cpu huc6280 -D ROMBANKS="$b_banks" "$@" -I "$lib" -o "$out/fx/$b_name.o" "$src/$b_stem.s" > "$out/fx/$b_name.log" 2>&1 \
    && ld65 -C "$lib/hucard.cfg" -D ROMBANKS="$b_banks" -o "$out/fixtures/$b_name.pce" "$out/fx/$b_name.o" >> "$out/fx/$b_name.log" 2>&1; then
    :
  else
    cat "$out/fx/$b_name.log"
    echo "FIXTURE_BUILD_FAILED $b_name"
    exit 1
  fi
  sha=$($sha_tool "$out/fixtures/$b_name.pce" | awk '{ print $1 }')
  bytes=$(wc -c < "$out/fixtures/$b_name.pce" | tr -d ' ')
  case $sha in
    '' | *[!0-9a-f]*) echo "HARNESS_ERROR the host sha tool gave no digest for $b_name" >&2; exit 2 ;;
  esac
  if [ "${#sha}" -ne 64 ] || [ "$bytes" -eq 0 ]; then
    echo "HARNESS_ERROR the host tools gave an unusable digest or size for $b_name" >&2
    exit 2
  fi
  printf '%s %s %s\n' "$b_name" "$bytes" "$sha" >> "$out/fixtures-authored.used"
  write_observe "$b_stem" "$b_name"
  n=$((n + 1))
}

n=0
for s in "$src"/*.s; do
  [ -f "$s" ] || continue
  stem=$(basename "$s" .s)
  case $stem in
    '' | *[!a-z0-9_]*) echo "HARNESS_ERROR the fixture source name '$stem' is outside a-z 0-9 _" >&2; exit 2 ;;
  esac
  name=$(printf '%s' "$stem" | tr '_' '-')
  build_one "$stem" "$name" 32
  # the variants of this source: one image per line of the list, built from the same source with the -D switches of that line
  while read -r v_stem v_name v_banks v_flags; do
    [ "$v_stem" = "$stem" ] || continue
    case $v_name in
      '' | *[!a-z0-9-]*) echo "HARNESS_ERROR the variant name '$v_name' is outside a-z 0-9 -" >&2; exit 2 ;;
    esac
    case $v_banks in
      '' | *[!0-9]*) echo "HARNESS_ERROR the ROMBANKS '$v_banks' of the variant '$v_name' is not a number" >&2; exit 2 ;;
    esac
    # shellcheck disable=SC2086
    build_one "$stem" "$v_name" "$v_banks" $v_flags
  done <<VARIANTS
$variants
VARIANTS
done

if [ "$n" -eq 0 ]; then
  echo "FIXTURE_BUILD_EMPTY no fixtures/src/*.s source was found"
  exit 1
fi
echo "STATUS fixture-build ok n=$n"
exit 0
