#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# ci-timings - one CI run as one markdown row for docs/ci-timings.md (CI-01, D-63). It only prints the row: the owner or the
# executor appends it to the table in a normal commit, so no bot commit and no artifact upload exists (D-63). It never writes to the
# repository, and a control never runs it against the network.
# usage: ci-timings RUN_ID          RUN_ID is the numeric GitHub Actions run id; the one network call is a read-only  gh run view
#        ci-timings --tsv FILE      the same record shape read from a file (the offline mode that the controls use)
# The record shape (TAB-separated; blank lines and lines starting with # are ignored), exactly what the gh --jq expression below prints:
#   run  ID  createdAt  startedAt  conclusion        one line
#   job  NAME  startedAt  completedAt                 one line per job (a job that never ran carries a 0001- timestamp and is shown as skipped)
#   a timestamp is ISO 8601 UTC with a Z suffix, for example 2028-03-01T00:00:02Z
# stdout: one row   | date (UTC) | run id | queue seconds | job=seconds, ... | run wall seconds | conclusion |
#   queue seconds = run startedAt minus run createdAt; a job's seconds = completedAt minus startedAt;
#   run wall seconds = the latest job completedAt minus run startedAt, which is the critical path of the run.
# The timestamp-to-epoch conversion is day arithmetic in awk (no GNU date, no BSD date: the two disagree on flags).
# exit  : 0 row printed | 2 usage error, missing gh, a failed gh call, a malformed record or an unusable timestamp
set -eu
LC_ALL=C; export LC_ALL

usage() {
  echo "usage: ci-timings RUN_ID | ci-timings --tsv FILE" >&2
  exit 2
}

[ $# -ge 1 ] || usage
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

case $1 in
  --tsv)
    [ $# -eq 2 ] || usage
    src=$2
    [ -f "$src" ] || { echo "HARNESS_NO_FILE $src" >&2; exit 2; }
    ;;
  -*) usage ;;
  *)
    [ $# -eq 1 ] || usage
    case $1 in
      '' | *[!0-9]*) echo "HARNESS_BAD_RUN_ID the run id must be digits only" >&2; exit 2 ;;
    esac
    command -v gh > /dev/null 2>&1 || { echo "HARNESS_NO_GH the gh command is not installed" >&2; exit 2; }
    # read-only: gh's built-in --jq prints the record shape above, the run first and then its jobs
    gh run view "$1" --json databaseId,createdAt,startedAt,conclusion,jobs \
      --jq '"run\t\(.databaseId)\t\(.createdAt)\t\(.startedAt)\t\(.conclusion)", (.jobs[] | "job\t\(.name)\t\(.startedAt)\t\(.completedAt)")' \
      > "$tmp/run.tsv" || { echo "HARNESS_GH_FAILED gh run view did not complete" >&2; exit 2; }
    src=$tmp/run.tsv
    ;;
esac

if awk '
function fail(why) {
  printf "CI_TIMINGS_MALFORMED line %d: %s\n", NR, why > "/dev/stderr"
  bad = 1
  exit 2
}
# epoch: seconds since 1970-01-01T00:00:00Z of an ISO timestamp, -1 when the text is not one. Day arithmetic (days from civil date).
function epoch(t,   y, m, d, hh, mi, ss, era, yoe, doy, days) {
  if (t !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/) return -1
  y = substr(t, 1, 4) + 0; m = substr(t, 6, 2) + 0; d = substr(t, 9, 2) + 0
  hh = substr(t, 12, 2) + 0; mi = substr(t, 15, 2) + 0; ss = substr(t, 18, 2) + 0
  if (m < 1 || m > 12 || d < 1 || d > 31 || hh > 23 || mi > 59 || ss > 60) return -1
  if (m <= 2) y = y - 1
  era = int(y / 400)
  yoe = y - era * 400
  doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
  days = era * 146097 + yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy - 719468
  return days * 86400 + hh * 3600 + mi * 60 + ss
}
BEGIN { FS = "\t" }
index($0, sprintf("%c", 13)) > 0 { fail("carriage return in the record") }
$0 == "" || substr($0, 1, 1) == "#" { next }
$1 == "run" {
  if (NF != 5) fail("a run record has 5 fields")
  if (nrun > 0) fail("more than one run record")
  nrun = 1
  rid = $2
  if (rid !~ /^[0-9]+$/) fail("the run id is not digits")
  created = epoch($3); started = epoch($4)
  if (created < 0) fail("createdAt is not an ISO UTC timestamp")
  if (started < 0) fail("startedAt is not an ISO UTC timestamp")
  if (started < created) fail("the run started before it was created")
  rdate = substr($3, 1, 10)
  concl = $5
  if (concl == "") fail("the run has no conclusion yet (it has not finished)")
  if (concl !~ /^[a-z_]+$/) fail("the conclusion is not a lowercase word")
  next
}
$1 == "job" {
  if (NF != 4) fail("a job record has 4 fields")
  if (nrun == 0) fail("a job record before the run record")
  if ($2 == "" || index($2, "|") > 0 || index($2, "\\") > 0) fail("the job name is empty or holds a pipe or a backslash")
  njob++
  if (substr($3, 1, 5) == "0001-" || substr($4, 1, 5) == "0001-") {
    jlist = jlist (njob > 1 ? ", " : "") $2 "=skipped"
    next
  }
  js = epoch($3); jc = epoch($4)
  if (js < 0) fail("a job startedAt is not an ISO UTC timestamp")
  if (jc < 0) fail("a job completedAt is not an ISO UTC timestamp")
  if (jc < js) fail("a job completed before it started")
  if (js < started) fail("a job started before its run")
  jlist = jlist (njob > 1 ? ", " : "") $2 "=" (jc - js)
  nran++
  if (jc > lastend) lastend = jc
  next
}
{ fail("not a run record, a job record, a comment or a blank line") }
END {
  if (bad) exit 2
  if (nrun == 0) fail("no run record")
  if (nran == 0) fail("no job record that ran")
  printf "| %s | %s | %d | %s | %d | %s |\n", rdate, rid, started - created, jlist, lastend - started, concl
}
' "$src"; then
  exit 0
else
  exit 2
fi
