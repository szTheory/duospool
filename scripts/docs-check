#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026 The DuoSpool Authors
#
# docs-check - static assertions about the documented gate command (TOOL-02, D-60). A documented command that CI mirrors is only true
# while the documentation cannot drift from it; this checker reads three files and never runs the gate.
# usage: docs-check [--expect CODE[,CODE...]] [--root DIR]      (--root defaults to the repository root)
#   Codes (one rule each):
#     DOC_NO_GATE_README       ROOT/README.md lacks the whole line  sh scripts/check  (the code block of the Local gate section)
#     DOC_NO_GATE_AGENTS       ROOT/AGENTS.md does not contain the string  sh scripts/check
#     DOC_STALE_STATUS         ROOT/README.md still says there is no emulator code yet (the retired Phase 1 status sentence)
#     DOC_FLAG_UNDOCUMENTED    a --flag named in the usage line of ROOT/scripts/check does not appear in ROOT/README.md
#     DOCS_TOOL_MISSING        a tool on the default list of ROOT/scripts/preflight (the line  tools="..." ) is not named as a word in
#                              ROOT/README.md; for an entry a|b one alternative named is enough. Skipped when ROOT has no scripts/preflight
#                              (the older mini roots); the real repository always has it and its preflight stage fails without it.
#     DOCS_CLAIM_WORD          ROOT/README.md contains a withheld claim word (ER-6: accurate, cycle-accurate, interrupt-accurate, pad-accurate,
#                              hardware-verified, compatible, supports TG-16, supports PC Engine, boots, passes the CPU tests; case-insensitive,
#                              whole words). The only place allowed is the README's own policy line, the one line that starts with
#                              Withheld claim words: , and there only inside double quotes. A quoted word on any other line is a violation.
#     DOCS_SUPPORTED_LIST      the entry ids in the README paragraph that starts with Supported entries (until the next blank line) are not exactly
#                              the entries of ROOT/ledger/entries whose status is supported. Skipped when ROOT has no ledger/entries.
#     DOCS_SUPPORTED_MEANING   at least one entry is supported and the README does not say what that means in the fixed plain words
#                              documentary comparison and not a hardware measurement. Skipped when ROOT has no ledger/entries.
# stdout: sorted violations  FILE<TAB>CODE<TAB>LINE<TAB>DETAIL , then (clean) the line  STATUS docs ok
# stdout on a met --expect: the single line EXPECT_OK (scripts/check treats a silent exit 0 as a dead checker)
# exit  : 0 pass (or --expect met) | 1 violations (or --expect not met) | 2 usage or harness error
set -eu
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd)

usage() {
  echo "usage: docs-check [--expect CODE[,CODE...]] [--root DIR]" >&2
  exit 2
}

expect=""
have_expect=0
root=$(cd "$here/.." && pwd)
while [ $# -gt 0 ]; do
  case $1 in
    --expect) [ $# -ge 2 ] || usage; expect=$2; have_expect=1; shift 2 ;;
    --root) [ $# -ge 2 ] || usage; root=$2; shift 2 ;;
    *) usage ;;
  esac
done
# an --expect that names no code would make a control assert nothing (WR-05): exit 2, never 0
if [ "$have_expect" -eq 1 ] && [ -z "$(printf '%s' "$expect" | tr -d ', \t\r\n')" ]; then
  echo "HARNESS_EMPTY_EXPECT --expect names no code" >&2
  exit 2
fi
if [ ! -d "$root" ]; then
  echo "HARNESS_NO_FILE $root" >&2
  exit 2
fi
root=$(cd "$root" && pwd)
for f in README.md AGENTS.md scripts/check; do
  [ -f "$root/$f" ] || { echo "HARNESS_NO_FILE $f" >&2; exit 2; }
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
viol0="$tmp/viol0"
viol="$tmp/viol"
: > "$viol0"

addv() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >> "$viol0"; }

readme="$root/README.md"
agents="$root/AGENTS.md"
gatesh="$root/scripts/check"

# the gate command, as a whole line, in the README code block
grep -qxF 'sh scripts/check' "$readme" || addv README.md DOC_NO_GATE_README 0 "the line 'sh scripts/check' is missing"
grep -qF 'sh scripts/check' "$agents" || addv AGENTS.md DOC_NO_GATE_AGENTS 0 "the string 'sh scripts/check' is missing"
# the retired Phase 1 status sentence
grep -qF 'no emulator code yet' "$readme" && addv README.md DOC_STALE_STATUS 0 "the retired status sentence 'no emulator code yet' is still present" # rule-stale

# every flag of the usage line: the first line of scripts/check that starts with  # usage:  (a continuation line is not read)
ul=$(grep -m 1 '^# usage:' "$gatesh" || true)
if [ -z "$ul" ]; then
  echo "HARNESS_NO_USAGE scripts/check has no '# usage:' line" >&2
  exit 2
fi
flags=$(printf '%s\n' "$ul" | tr -c 'A-Za-z0-9\n-' ' ' | tr ' ' '\n' | grep -E '^--[A-Za-z][A-Za-z0-9-]*$' | sort -u || true)
if [ -z "$flags" ]; then
  echo "HARNESS_NO_FLAGS the usage line of scripts/check names no --flag" >&2
  exit 2
fi
for fl in $flags; do
  grep -qF -e "$fl" "$readme" || addv README.md DOC_FLAG_UNDOCUMENTED 0 "usage flag $fl is not in README.md"
done

# every tool of the default preflight list is named in the README (ER-6: a documented prerequisite list must be the true one)
pre="$root/scripts/preflight"
if [ -f "$pre" ]; then
  tl=$(grep -m 1 '^tools="' "$pre" || true)
  tl=${tl#tools=\"}
  tl=${tl%%\"*}
  if [ -z "$tl" ]; then
    echo "HARNESS_NO_TOOLS scripts/preflight has no tools=\"...\" default line" >&2
    exit 2
  fi
  set -f
  for entry in $tl; do
    named=0
    rest=$entry
    while [ -n "$rest" ]; do
      case $rest in
        *'|'*) alt=${rest%%'|'*}; rest=${rest#*'|'} ;;
        *) alt=$rest; rest="" ;;
      esac
      [ -n "$alt" ] || continue
      # a name is a word: not glued to a letter, digit, underscore or hyphen (so cc is not found inside cc65)
      if grep -qE "(^|[^A-Za-z0-9_-])$alt([^A-Za-z0-9_-]|\$)" "$readme"; then named=1; fi
    done
    [ "$named" -eq 1 ] || addv README.md DOCS_TOOL_MISSING 0 "preflight tool $entry is not named in README.md" # rule-tool-named
  done
  set +f
fi

# withheld claim words (ER-6): lower-case, whole words (the characters on either side are not letters, digits or underscore, so a hyphen
# is a boundary and cycle-accurate is found by accurate). Allowed only inside double quotes on the policy line. POSIX awk only (no \b, no IGNORECASE).
cw_hits=$(awk '
  BEGIN {
    re = "(^|[^a-z0-9_])(accurate|cycle-accurate|interrupt-accurate|pad-accurate|hardware-verified|compatible|supports tg-16|supports pc engine|boots|passes the cpu tests)([^a-z0-9_]|$)"
  }
  {
    line = $0
    if (line ~ /^Withheld claim words:/) {
      gsub(/"[^"]*"/, "", line)
    }
    if (tolower(line) ~ re) { print NR }
  }
' "$readme")
cw_count=0
for cw_n in $cw_hits; do
  addv README.md DOCS_CLAIM_WORD "$cw_n" "a withheld claim word outside the quoted policy line" # rule-claim-word
  cw_count=$((cw_count + 1))
done

# supported entries (ER-2, ER-6): the README names exactly the ledger entries whose status is supported, and says in fixed plain words what that means
led="$root/ledger/entries"
if [ -d "$led" ]; then
  sup=$(for f in "$led"/*.toml; do
    [ -f "$f" ] || continue
    if grep -qx 'status = "supported"' "$f"; then
      grep -m 1 '^id = "' "$f" | sed 's/^id = "//; s/".*$//'
    fi
  done | sort -u | tr '\n' ' ')
  listed=$(awk '
    /^Supported entries/ { inpar = 1 }
    /^[ \t]*$/ { inpar = 0 }
    inpar {
      s = $0
      while (match(s, /LED-[A-Z]+-[0-9]+/)) {
        print substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
      }
    }
  ' "$readme" | sort -u | tr '\n' ' ')
  [ "$sup" = "$listed" ] || addv README.md DOCS_SUPPORTED_LIST 0 "README lists [$listed] but the ledger has supported [$sup]" # rule-supported-list
  if [ -n "$sup" ]; then
    # the text is joined first: the README wraps its lines, and the phrases may break across one
    tr '\n' ' ' < "$readme" | tr -s ' ' > "$tmp/readme.flat"
    sm_ok=0
    if grep -qF 'documentary comparison' "$tmp/readme.flat" && grep -qF 'not a hardware measurement' "$tmp/readme.flat"; then sm_ok=1; fi
    [ "$sm_ok" -eq 1 ] || addv README.md DOCS_SUPPORTED_MEANING 0 "supported entries exist but the README lacks the plain meaning" # rule-supported-meaning
  fi
fi

sort -u "$viol0" > "$viol"

if [ "$have_expect" -eq 1 ]; then
  got=$(awk -F'\t' '{ print $2 }' "$viol" | sort -u | tr '\n' ',' | sed 's/,$//')
  want=$(printf '%s\n' "$expect" | tr ',' '\n' | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ "$got" = "$want" ]; then
    echo "EXPECT_OK"
    exit 0
  fi
  echo "EXPECT_MISMATCH wanted '$want' got '${got:-<none>}'" >&2
  cat "$viol" >&2
  exit 1
fi

cat "$viol"
if [ -s "$viol" ]; then
  exit 1
fi
echo "STATUS docs ok"
exit 0
