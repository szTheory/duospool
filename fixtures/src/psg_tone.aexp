row	tone_atten	lev_P1	anchor=ev:ch=2;reg=R4;val=$9F;nth=2;from=+51152;to=+295912;side=R	peak=1015808;r1=$FF;al=$1F;r5=$FF
group	tone_atten	same_Y	form=REL	kind=same	class=MAN:P8-4	kills=AF0,AF5,AF6
row	tone_atten	same_Y	anchor=ev:ch=2;reg=R4;val=$9F;nth=2;from=+51152;to=+200608;side=L	n=256;r1=$FF;al=$1F;r5=$FF
