# Build outputs
target/
build/
prefix/
*.a
.DS_Store

# Generated spike fixtures look like ROMs and are never committed (D-35)
spikes/tool-01/out/

# Fuzzing artifacts
fuzz/artifacts/
fuzz/corpus/

# ROM-like extensions, so such files cannot be staged by accident (T-01-12).
# These patterns are active, not commented out. The Phase 2 FIX-05 tree check is the real gate.
# Authored fixture ROMs (Phase 3) are assembled in the gate into the ignored build/ directory and are never committed (D-123, D-133),
# so no !-prefixed allow rule exists and nothing ROM-like is tracked.
*.pce
*.sgx
*.iso
*.cue
*.bin
*.img
*.chd
*.sav
*.srm
